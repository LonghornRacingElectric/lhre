// Board build/flash tasks are managed by tools/new_board.py, which
// regenerates them by label — see tools/debug/README.md. Hand-written
// entries with other labels are left alone (comments are not).
{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build-vcu-debug",
      "detail": "Build VCU firmware and stage the hermetic debug tools",
      "type": "shell",
      "command": "bazel",
      "args": [
        "build",
        "//boards/VCU:vcu.elf",
        "//tools/debug:debug_tools"
      ],
      "group": "build",
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "flash-vcu",
      "detail": "Flash the VCU over ST-Link without starting a debug session",
      "type": "shell",
      "command": "bazel",
      "args": [
        "run",
        "//boards/VCU:openocd"
      ],
      "problemMatcher": []
    },
    {
      "label": "flash-vcu-dfu",
      "detail": "Flash the VCU over USB DFU",
      "type": "shell",
      "command": "bazel",
      "args": [
        "run",
        "//boards/VCU:dfu"
      ],
      "problemMatcher": []
    },
    {
      "label": "monitor-vcu",
      "detail": "Open serial monitor for VCU",
      "type": "shell",
      "command": "bazel",
      "args": [
        "run",
        "//tools/monitor"
      ],
      "problemMatcher": []
    },
    {
      "label": "flash-and-monitor-vcu",
      "detail": "Flash the VCU (prompts for ST-Link vs DFU) and open serial monitor",
      "type": "shell",
      "command": "bazel",
      "args": [
        "run",
        "//tools/monitor",
        "--",
        "--flash",
        "//boards/VCU:${input:flashMethod-vcu}"
      ],
      "problemMatcher": []
    },
    {
      "label": "build-hvc-debug",
      "detail": "Build HVC firmware and stage the hermetic debug tools",
      "type": "shell",
      "command": "bazel",
      "args": [
        "build",
        "//boards/HVC:hvc.elf",
        "//tools/debug:debug_tools"
      ],
      "group": "build",
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "flash-hvc",
      "detail": "Flash the HVC over ST-Link without starting a debug session",
      "type": "shell",
      "command": "bazel",
      "args": [
        "run",
        "//boards/HVC:openocd"
      ],
      "problemMatcher": []
    },
    {
      "label": "flash-hvc-dfu",
      "detail": "Flash the HVC over USB DFU",
      "type": "shell",
      "command": "bazel",
      "args": [
        "run",
        "//boards/HVC:dfu"
      ],
      "problemMatcher": []
    },
    {
      "label": "monitor-hvc",
      "detail": "Open serial monitor for HVC",
      "type": "shell",
      "command": "bazel",
      "args": [
        "run",
        "//tools/monitor"
      ],
      "problemMatcher": []
    },
    {
      "label": "flash-and-monitor-hvc",
      "detail": "Flash the HVC (prompts for ST-Link vs DFU) and open serial monitor",
      "type": "shell",
      "command": "bazel",
      "args": [
        "run",
        "//tools/monitor",
        "--",
        "--flash",
        "//boards/HVC:${input:flashMethod-hvc}"
      ],
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "flashMethod-vcu",
      "type": "pickString",
      "description": "Select flash method for VCU",
      "options": [
        {
          "label": "ST-Link (OpenOCD)",
          "value": "openocd"
        },
        {
          "label": "DFU (USB)",
          "value": "dfu"
        }
      ],
      "default": "openocd"
    },
    {
      "id": "flashMethod-hvc",
      "type": "pickString",
      "description": "Select flash method for HVC",
      "options": [
        {
          "label": "ST-Link (OpenOCD)",
          "value": "openocd"
        },
        {
          "label": "DFU (USB)",
          "value": "dfu"
        }
      ],
      "default": "openocd"
    }
  ]
}
