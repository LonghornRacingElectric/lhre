load("//tools/firmware:firmware_project.bzl", "firmware_project")

# The whole board: firmware image, flash targets, and — synthesized
# from the App/ file names — the app library, host tests, and sims.
# Everything else is derived from mcu or the CubeMX layout; see
# tools/firmware/README.md. State only what this board adds.
firmware_project(
    name = "vcu",
    # Generated CAN bindings, per source board: what the VCU sends plus
    # what it listens to — not the whole bus.
    app_deps = [
        # Debug shell over the PA2/PA3 UART (the ST-LINK VCP pins);
        # tools/monitor is the laptop side.
        "//drivers/longhorn:logger",
        "//drivers/longhorn:shell",
        "//lib/codegen/cpp:can_hvc",
        "//lib/codegen/cpp:can_vcu",
    ],
    # LPUART1 isn't in VCU.ioc yet, so the CubeMX-owned hal_conf.h can't
    # enable the UART HAL module; supply the define here until it is (see
    # the debug-UART TODO in Board/main.cpp).
    defines = ["HAL_UART_MODULE_ENABLED"],
    enable_freertos = True,
    enable_usb = True,
    mcu = "stm32g474xx",
)
