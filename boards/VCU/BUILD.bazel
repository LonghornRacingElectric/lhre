load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_test.bzl", "cc_test")
load("//drivers/lhal:lhal_library.bzl", "lhal_cc_library")
load("//tools/firmware:firmware_project.bzl", "firmware_project")

# Application logic: LHAL interfaces only, no ST HAL. Compiles for both the
# MCU (linked into :vcu below) and the host (:vcu_app_test, :vcu_sim).
lhal_cc_library(
    name = "vcu_app",
    srcs = ["App/vcu_app.cpp"],
    hdrs = ["App/vcu_app.hpp"],
    family = "stm32g4",
    includes = ["App"],
    deps = ["//drivers/lhal"],
)

cc_test(
    name = "vcu_app_test",
    size = "small",
    srcs = ["App/vcu_app_test.cpp"],
    deps = [
        ":vcu_app",
        "//drivers/lhal:host",
        "@googletest//:gtest_main",
    ],
)

cc_binary(
    name = "vcu_sim",
    srcs = ["App/vcu_sim.cpp"],
    deps = [
        ":vcu_app",
        "//drivers/lhal:host",
    ],
)

firmware_project(
    name = "vcu",
    srcs = glob(
        [
            "Core/Src/**/*.c",
            "Board/**/*.cpp",
            "Board/**/*.hpp",
        ],
        allow_empty = True,
        # Core/ is 100% CubeMX-owned and regenerable; hand-written bring-up
        # lives in Board/. CubeMX regeneration recreates main.c — run
        # post_cubemx.sh after "Generate Code" to delete it (our entry point
        # is Board/main.cpp); the exclude keeps the build safe even if the
        # script wasn't run.
        exclude = ["Core/Src/main.c"],
    ) + glob(
        [
            "Core/Inc/**/*.h",
            "Core/Inc/**/*.hpp",
        ],
        allow_empty = True,
    ),
    defines = ["STM32G474xx"],
    enable_printf_float = True,
    extra_deps = [
        ":vcu_app",
        "//drivers/lhal:stm32_headers",
    ],
    extra_srcs = ["//drivers/lhal:stm32_srcs"],
    family = "stm32g4",
    linker_script = "STM32G474XX_FLASH.ld",
    startup_script = "startup_stm32g474xx.s",
)
