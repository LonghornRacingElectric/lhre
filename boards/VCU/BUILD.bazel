load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")
load("//tools/firmware:firmware_project.bzl", "firmware_project")

# Application logic: LHAL interfaces only, no ST HAL. Compiles for both the
# MCU (linked into :vcu below) and the host (:vcu_app_test, :vcu_sim); the
# per-family platform/toolchain supplies MCU flags when cross-compiling.
cc_library(
    name = "vcu_app",
    srcs = ["App/vcu_app.cpp"],
    hdrs = ["App/vcu_app.hpp"],
    includes = ["App"],
    deps = ["//drivers/lhal"],
)

cc_test(
    name = "vcu_app_test",
    size = "small",
    srcs = ["App/vcu_app_test.cpp"],
    deps = [
        ":vcu_app",
        "//drivers/lhal:host",
        "@googletest//:gtest_main",
    ],
)

cc_binary(
    name = "vcu_sim",
    srcs = ["App/vcu_sim.cpp"],
    deps = [
        ":vcu_app",
        "//drivers/lhal:host",
    ],
)

firmware_project(
    name = "vcu",
    srcs = glob(
        [
            "Core/Src/**/*.c",
            "Board/**/*.cpp",
            "Board/**/*.hpp",
        ],
        allow_empty = True,
        # Core/ is 100% CubeMX-owned and regenerable; hand-written bring-up
        # lives in Board/. The generated main.c IS compiled: with
        # ProjectManager.NoMain=true (set in VCU.ioc) it contains
        # SystemClock_Config() and Error_Handler() but no main() — our entry
        # point is Board/main.cpp, which reaches the generated clock config
        # via lhal::stm32::InitCore(). If NoMain is ever flipped back, the
        # duplicate main() shows up as a link error here.
    ) + glob(
        [
            "Core/Inc/**/*.h",
            "Core/Inc/**/*.hpp",
        ],
        allow_empty = True,
    ),
    defines = ["STM32G474xx"],
    enable_printf_float = True,
    extra_deps = [
        ":vcu_app",
        "//drivers/lhal:stm32_headers",
    ],
    extra_srcs = ["//drivers/lhal:stm32_srcs"],
    family = "stm32g4",
    linker_script = "STM32G474XX_FLASH.ld",
    startup_script = "startup_stm32g474xx.s",
)
