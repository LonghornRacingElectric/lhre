load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")
load("//tools/firmware:firmware_project.bzl", "firmware_project")

# The board's CubeMX-generated FreeRTOS config, exposed on its own so app
# code can compile against FreeRTOS headers when cross-compiling (the kernel
# requires FreeRTOSConfig.h on the include path everywhere FreeRTOS.h is
# included, not just where the kernel sources are compiled).
cc_library(
    name = "vcu_freertos_config",
    hdrs = ["Core/Inc/FreeRTOSConfig.h"],
    strip_include_prefix = "Core/Inc",
)

# Application logic: LHAL interfaces + raw FreeRTOS API, no ST HAL. Compiles
# for both the MCU (linked into :vcu below) and the host (:vcu_app_test,
# :vcu_rtos_test, :vcu_sim). FreeRTOS comes from the same kernel checkout on
# both sides — Cortex-M port + board config when cross-compiling, simulator
# port + host config otherwise — so task code runs unmodified on the host.
cc_library(
    name = "vcu_app",
    srcs = ["App/vcu_app.cpp"],
    hdrs = ["App/vcu_app.hpp"],
    includes = ["App"],
    deps = ["//drivers/lhal"] + select({
        "@platforms//os:none": [
            ":vcu_freertos_config",
            "//drivers/stm32/stm32g4:freertos_headers",
        ],
        "//conditions:default": ["//drivers/freertos:host"],
    }),
)

cc_test(
    name = "vcu_app_test",
    size = "small",
    srcs = ["App/vcu_app_test.cpp"],
    deps = [
        ":vcu_app",
        "//drivers/lhal:host",
        "@googletest//:gtest_main",
    ],
)

# Runs the app's real FreeRTOS tasks under the simulator port's scheduler.
# Complements :vcu_app_test (deterministic, TestClock-driven): this one
# checks the task wiring itself, with generous timing bounds.
cc_test(
    name = "vcu_rtos_test",
    size = "small",
    srcs = ["App/vcu_rtos_test.cpp"],
    deps = [
        ":vcu_app",
        "//drivers/lhal:host",
        "@googletest//:gtest_main",
    ],
)

cc_binary(
    name = "vcu_sim",
    srcs = ["App/vcu_sim.cpp"],
    deps = [
        ":vcu_app",
        "//drivers/lhal:host",
    ],
)

firmware_project(
    name = "vcu",
    srcs = glob(
        [
            "Core/Src/**/*.c",
            "Board/**/*.cpp",
            "Board/**/*.hpp",
        ],
        allow_empty = True,
        # Core/ is 100% CubeMX-owned and regenerable; hand-written bring-up
        # lives in Board/. The generated main.c IS compiled: with
        # ProjectManager.NoMain=true (set in VCU.ioc) it contains
        # SystemClock_Config() and Error_Handler() but no main() — our entry
        # point is Board/main.cpp, which reaches the generated clock config
        # via lhal::stm32::InitCore(). If NoMain is ever flipped back, the
        # duplicate main() shows up as a link error here.
        #
        # app_freertos.c is CubeMX's CMSIS-RTOS2 glue (osKernel* + a default
        # task). We use the raw FreeRTOS API — tasks are created in
        # Board/main.cpp — so it stays committed (CubeMX regenerates it) but
        # is never compiled. Everything CubeMX vendors under Middlewares/ is
        # likewise unused and gitignored: the kernel sources come from
        # @freertos_kernel via enable_freertos below (one version shared
        # with host tests), and the cmsis_os.h include in the generated
        # main.c is satisfied by //drivers/freertos:cmsis_os_stub, which
        # enable_freertos wires in along with the SysTick glue. See
        # drivers/freertos/README.md.
        exclude = ["Core/Src/app_freertos.c"],
    ) + glob(
        [
            "Core/Inc/**/*.h",
            "Core/Inc/**/*.hpp",
        ],
        allow_empty = True,
    ),
    defines = ["STM32G474xx"],
    enable_freertos = True,
    enable_printf_float = True,
    extra_deps = [
        ":vcu_app",
        "//drivers/lhal:stm32_headers",
    ],
    extra_srcs = ["//drivers/lhal:stm32_srcs"],
    family = "stm32g4",
    linker_script = "STM32G474XX_FLASH.ld",
    startup_script = "startup_stm32g474xx.s",
)
