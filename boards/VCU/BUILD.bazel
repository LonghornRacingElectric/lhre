load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")
load("@rules_python//python:defs.bzl", "py_binary", "py_test")
load("//boards/VCU:Sil/can_table.bzl", "vcu_sil_can_table")
load("//tools/firmware:firmware_project.bzl", "firmware_project")

firmware_project(
    name = "vcu",
    app_deps = [
        "//drivers/longhorn:can_inbox",
        "//drivers/longhorn:console",
        "//drivers/longhorn:debounce",
        "//drivers/longhorn:dfu",
        "//drivers/longhorn:dfu_console",
        "//drivers/longhorn:led",
        "//drivers/longhorn:logger",
        "//drivers/longhorn:math",
        "//drivers/longhorn:period",
        "//drivers/longhorn:rainbow_task",
        "//drivers/longhorn:rate_gate",
        "//drivers/longhorn:rtos_lock",
        "//drivers/longhorn:shell",
        "//tools/firmware:build_info",
        "//lib/codegen/cpp:can_bench",
        "//lib/codegen/cpp:can_dui",
        "//lib/codegen/cpp:can_hvc",
        "//lib/codegen/cpp:can_inverter",
        "//lib/codegen/cpp:can_pdu",
        "//lib/codegen/cpp:can_pi",
        "//lib/codegen/cpp:can_vcu",
        "//lib/codegen/cpp:can_rx_vcu",
        "//lib/codegen/cpp:can_tsm",
        "//lib/codegen/cpp:can_usm",
    ],
    enable_freertos = True,
    enable_usb = True,
    mcu = "stm32g474xx",
)

alias(
    name = "VCU",
    actual = ":vcu",
)

# Software-in-the-loop rig (Sil/README.md). These targets live here, not in a
# Sil/ package, because :vcu_app is private to this package. They link the
# bench's LHAL fakes, so they never build for the MCU.
SIL_HOST_ONLY = select({
    "@platforms//os:none": ["@platforms//:incompatible"],
    "//conditions:default": [],
})

SIL_COPTS = [
    "-Wall",
    "-Wextra",
    "-Werror",
]

cc_library(
    name = "vcu_sil_rig",
    srcs = [
        "Sil/rig.cpp",
        "Sil/sensors.cpp",
    ],
    hdrs = [
        "Sil/rig.hpp",
        "Sil/sensors.hpp",
    ],
    copts = SIL_COPTS,
    strip_include_prefix = "/boards/VCU",
    target_compatible_with = SIL_HOST_ONLY,
    deps = [
        ":vcu_app",
        "//drivers/lhal:host",
        "//drivers/longhorn:math",
        "//drivers/longhorn:period",
        "//lib/codegen/cpp:can_dui",
        "//lib/codegen/cpp:can_hvc",
        "//lib/codegen/cpp:can_inverter",
        "//lib/codegen/cpp:can_pdu",
        "//lib/codegen/cpp:can_usm",
        "//lib/codegen/cpp:can_vcu",
    ],
)

cc_test(
    name = "vcu_sil_rig_test",
    size = "small",
    srcs = ["Sil/rig_test.cpp"],
    copts = SIL_COPTS,
    target_compatible_with = SIL_HOST_ONLY,
    deps = [
        ":vcu_app",
        ":vcu_sil_rig",
        "//drivers/lhal:host",
        "//lib/codegen/cpp:can_dui",
        "//lib/codegen/cpp:can_hvc",
        "//lib/codegen/cpp:can_inverter",
        "//lib/codegen/cpp:can_pdu",
        "//lib/codegen/cpp:can_usm",
        "//lib/codegen/cpp:can_vcu",
        "@googletest//:gtest_main",
    ],
)

# The C ABI for co-simulation hosts. Linux only: the version script and the
# hosts that load it (fmpy beside an OpenModelica FMU) are Linux.
cc_library(
    name = "vcu_sil_api",
    hdrs = ["Sil/vcu_sil.h"],
    strip_include_prefix = "/boards/VCU",
    target_compatible_with = ["@platforms//os:linux"],
)

cc_binary(
    name = "libvcu_sil.so",
    srcs = ["Sil/vcu_sil.cpp"],
    additional_linker_inputs = ["Sil/vcu_sil.lds"],
    copts = SIL_COPTS,
    linkopts = [
        "-Wl,--version-script=$(location Sil/vcu_sil.lds)",
        "-Wl,-z,defs",
    ],
    linkshared = True,
    target_compatible_with = ["@platforms//os:linux"],
    deps = [
        ":vcu_app",
        ":vcu_sil_api",
        ":vcu_sil_rig",
        "//tools/firmware:build_info",
    ],
)

cc_test(
    name = "vcu_sil_test",
    size = "small",
    srcs = [
        "Sil/vcu_sil_test.cpp",
        ":libvcu_sil.so",
    ],
    copts = SIL_COPTS,
    linkopts = ["-ldl"],
    target_compatible_with = ["@platforms//os:linux"],
    deps = [
        ":vcu_sil_api",
        "@googletest//:gtest_main",
    ],
)

# The decode table the Python host reads captured frames with. Linux only,
# like the host that reads it.
py_binary(
    name = "vcu_sil_gen_can_table",
    srcs = ["Sil/gen_can_table.py"],
    main = "Sil/gen_can_table.py",
    target_compatible_with = ["@platforms//os:linux"],
    deps = ["//lib/spec:ir"],
)

py_test(
    name = "vcu_sil_gen_can_table_test",
    size = "small",
    srcs = [
        "Sil/gen_can_table.py",
        "Sil/gen_can_table_test.py",
    ],
    args = ["$(rlocationpaths //lib/spec:files)"],
    data = ["//lib/spec:files"],
    main = "Sil/gen_can_table_test.py",
    target_compatible_with = ["@platforms//os:linux"],
    deps = [
        "//lib/spec:ir",
        "@lhre_pypi//bazel_runfiles",
    ],
)

vcu_sil_can_table(
    name = "vcu_sil_can_table",
    out = "vcu_sil_can.json",
    spec = "//lib/spec:files",
    target_compatible_with = ["@platforms//os:linux"],
)
