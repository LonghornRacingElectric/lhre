load("//tools/firmware:firmware_project.bzl", "firmware_project")

firmware_project(
    name = "vcu",
    app_deps = [
        "//drivers/longhorn:logger",
        "//drivers/longhorn:led",
        "//drivers/longhorn:console",
        "//drivers/longhorn:shell",
        "//drivers/longhorn:period",
        "//drivers/longhorn:debounce",
        "//drivers/longhorn:rtos_lock",
        "//drivers/longhorn:can_inbox",
        "//tools/firmware:build_info",
        "//lib/codegen/cpp:can_bench",
        "//lib/codegen/cpp:can_dui",
        "//lib/codegen/cpp:can_hvc",
        "//lib/codegen/cpp:can_inverter",
        "//lib/codegen/cpp:can_pdu",
        "//lib/codegen/cpp:can_pi",
        "//lib/codegen/cpp:can_vcu",
        "//lib/codegen/cpp:can_rx_vcu",
        "//lib/codegen/cpp:can_usm",
    ],
    # USART3 is configured in Board/comms_setup.cpp, not the .ioc.
    defines = ["HAL_UART_MODULE_ENABLED"],
    enable_freertos = True,
    enable_usb = True,
    mcu = "stm32g474xx",
    # Keep vehicle and full bench images alongside minimal USB/LED bring-up.
    variants = {
        "mvp": ["VCU_MVP_IMAGE"],
        "test": ["VCU_TEST_IMAGE"],
    },
)
