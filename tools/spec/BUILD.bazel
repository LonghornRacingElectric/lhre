load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")

# Canonical formatter for lib/spec/*.textproto:
#   bazel run //tools/spec:fmt
py_binary(
    name = "fmt",
    srcs = ["fmt.py"],
    visibility = ["//visibility:private"],
    deps = ["//lib/spec:ir"],
)

# Local editing UI for the spec:
#   bazel run //tools/spec:editor
py_library(
    name = "editor_lib",
    srcs = ["editor.py"],
    data = ["editor_index.html"],
    deps = [
        "//lib/spec:ir",
        "@lhre_pypi//bazel_runfiles",
    ],
)

py_binary(
    name = "editor",
    srcs = ["editor.py"],
    visibility = ["//visibility:private"],
    deps = [":editor_lib"],
)

py_test(
    name = "editor_test",
    size = "small",
    srcs = ["editor_test.py"],
    deps = [":editor_lib"],
)

# Regenerate the committed wire contract (lib/spec/wire.lock):
#   bazel run //tools/spec:lock
py_binary(
    name = "lock",
    srcs = ["lock.py"],
    visibility = ["//visibility:private"],
    deps = ["//lib/spec:ir"],
)
