# arm-none-eabi cc_toolchains, one per CPU-core variant we ship firmware on.
#
# The upstream @arm_none_eabi toolchains carry no codegen flags; here each
# variant bakes its -mcpu/-mfpu/-mfloat-abi into both copts and linkopts
# (linkopts also drive newlib/libgcc multilib selection). Toolchain resolution
# picks the variant via the //platforms:mcu_core constraint on the target
# platform, so every cc_library in the dependency graph — not just the
# firmware binary — compiles with the right float ABI.
#
# arm_none_eabi_toolchain (toolchain.bzl here, not the fork's — see its
# docstring for why) instantiates a (config, cc_toolchain, toolchain) triple
# per host OS/arch; MODULE.bazel registers //toolchains:all.

load("@bazel_skylib//rules:common_settings.bzl", "string_flag")
load("//toolchains:toolchain.bzl", "arm_none_eabi_toolchain")

package(default_visibility = ["//visibility:public"])

# dwp_files placeholder referenced as ":empty" by arm_none_eabi_toolchain.
filegroup(name = "empty")

# Which compiler builds firmware (os:none targets). The //toolchains/llvm
# variants carry target_settings on :llvm_firmware, so "llvm" flips every
# firmware cc_* target to hermetic clang; host builds are unaffected.
# Convenience alias in .bazelrc: --config=llvm-fw.
string_flag(
    name = "firmware_compiler",
    build_setting_default = "gcc",
    values = [
        "gcc",
        "llvm",
    ],
)

config_setting(
    name = "llvm_firmware",
    flag_values = {":firmware_compiler": "llvm"},
)

arm_none_eabi_toolchain(
    name = "cortex_m0",
    copts = [
        "-mcpu=cortex-m0",
        "-mthumb",
        "-mfloat-abi=soft",
    ],
    linkopts = [
        "-mcpu=cortex-m0",
        "-mthumb",
        "-mfloat-abi=soft",
    ],
    target_compatible_with = [
        "@platforms//cpu:arm",
        "@platforms//os:none",
        "//platforms:cortex_m0",
    ],
    version = "13.2.1",
)

arm_none_eabi_toolchain(
    name = "cortex_m4f",
    copts = [
        "-mcpu=cortex-m4",
        "-mthumb",
        "-mfpu=fpv4-sp-d16",
        "-mfloat-abi=hard",
    ],
    linkopts = [
        "-mcpu=cortex-m4",
        "-mthumb",
        "-mfpu=fpv4-sp-d16",
        "-mfloat-abi=hard",
    ],
    target_compatible_with = [
        "@platforms//cpu:arm",
        "@platforms//os:none",
        "//platforms:cortex_m4f",
    ],
    version = "13.2.1",
)

arm_none_eabi_toolchain(
    name = "cortex_m7f",
    copts = [
        "-mcpu=cortex-m7",
        "-mthumb",
        "-mfpu=fpv5-d16",
        "-mfloat-abi=hard",
    ],
    linkopts = [
        "-mcpu=cortex-m7",
        "-mthumb",
        "-mfpu=fpv5-d16",
        "-mfloat-abi=hard",
    ],
    target_compatible_with = [
        "@platforms//cpu:arm",
        "@platforms//os:none",
        "//platforms:cortex_m7f",
    ],
    version = "13.2.1",
)
