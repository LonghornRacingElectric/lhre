"""Python proto toolchain backed by the pip protobuf runtime.

py_proto_library resolves @protobuf//bazel/private:python_toolchain_type.
protobuf's own registration pairs it with @protobuf//python:protobuf_python,
whose build runs protoc_minimal — compiled from source, dragging ~500
protobuf/abseil C++ actions into any build that touches the CAN spec.
Registering this toolchain first (root-module registrations win) swaps the
runtime for the pip wheel, so together with the prebuilt-protoc toolchain
(--incompatible_enable_proto_toolchain_resolution in .bazelrc) no protobuf
C++ is ever compiled. The tripwire flags in .bazelrc enforce that.

The pip protobuf version must satisfy the gencode check emitted by protoc:
runtime >= gencode, i.e. protobuf N.M in MODULE.bazel needs pip protobuf
7.N.M or newer in pyproject.toml. Bump them together.
"""

load("@protobuf//bazel/toolchains:proto_lang_toolchain.bzl", "proto_lang_toolchain")

# Also creates the :python_toolchain wrapper registered in MODULE.bazel.
proto_lang_toolchain(
    name = "python",
    command_line = "--python_out=%s",
    progress_message = "Generating Python proto_library %{label}",
    runtime = "@lhre_pypi//protobuf",
    toolchain_type = "@protobuf//bazel/private:python_toolchain_type",
)
