# bazel-bin, bazel-lhre, bazel-out, bazel-testlogs
bazel-*
external/
.venv
.idea
*.tools*
.bazelrc.user

# mkdocs output (see mkdocs.yml)
site/
.mkdocs-build/

# CubeMX-generated HAL copies inside board projects. Deliberately scoped to
# boards/: a bare "**/Drivers" also matches the top-level drivers/ tree on
# case-insensitive filesystems (macOS/Windows), silently ignoring new files
# there (this bit us with drivers/lhal).
boards/**/Drivers/
**/.mxproject
**/Makefile
MODULE.bazel.lock

# CubeMX-vendored FreeRTOS copies: the build compiles the kernel from
# @freertos_kernel instead (one version shared with host tests — see
# drivers/freertos/README.md). Exception: the CMSIS-RTOS2 wrapper *headers*
# stay tracked, because the CubeMX-generated Core/Src/main.c includes
# cmsis_os.h (an ST-specific header that exists nowhere upstream). The
# second pattern un-ignores directories so the header exception can apply;
# directories themselves are never tracked by git anyway.
/boards/**/Middlewares/**
!/boards/**/Middlewares/**/
!/boards/**/Middlewares/**/CMSIS_RTOS_V2/*.h
/boards/VCU/build
/.vscode
.claude/

# CMake stuff
boards/**/cmake/
boards/**/*.cmake
boards/**/CMakeLists.txt
/boards/VCU/cmake
