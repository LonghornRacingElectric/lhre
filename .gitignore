# bazel-bin, bazel-lhre, bazel-out, bazel-testlogs
bazel-*
external/
.venv
.idea
*.tools*
.bazelrc.user

# mkdocs output (see mkdocs.yml)
site/
.mkdocs-build/

# CubeMX-generated HAL copies inside board projects. Deliberately scoped to
# boards/: a bare "**/Drivers" also matches the top-level drivers/ tree on
# case-insensitive filesystems (macOS/Windows), silently ignoring new files
# there (this bit us with drivers/lhal).
boards/**/Drivers/
**/.mxproject
**/Makefile
MODULE.bazel.lock

# CubeMX-vendored middleware (FreeRTOS kernel + CMSIS-RTOS2 wrapper): never
# compiled. The kernel comes from @freertos_kernel (one version shared with
# host tests) and the cmsis_os.h include in the generated main.c is satisfied
# by //drivers/freertos:cmsis_os_stub — see drivers/freertos/README.md.
/boards/**/Middlewares/
