"""FreeRTOS kernel: one version for firmware and host.

The kernel is fetched once (see deps.bzl) and compiled two ways:

    //drivers/freertos:host  — the real kernel built for the host with the
                       POSIX (Linux/macOS) or Windows simulator port, so
                       task code runs unmodified in tests and sims.
    //drivers/freertos:hooks — static-allocation memory callbacks; compiled
                       into every build that compiles the kernel.

Firmware builds don't use a target here directly: the per-family driver
package (e.g. //drivers/stm32/stm32g4:freertos_srcs) bundles the kernel +
MCU port sources for compilation inside the firmware binary, where the
board's CubeMX-generated FreeRTOSConfig.h applies.
"""

load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")

# Bundled into each family's :freertos_srcs (the host build compiles hooks.c
# directly as a file). Not for boards: firmware gets the hooks via
# firmware_project(enable_freertos = True).
filegroup(
    name = "hooks",
    srcs = ["hooks.c"],
    visibility = ["//drivers/stm32:__subpackages__"],
)

# SysTick_Handler → xPortSysTickHandler() forwarding for CubeMX boards.
# Family-agnostic; wired into firmware binaries by
# firmware_project(enable_freertos = True), never used on the host.
filegroup(
    name = "cubemx_glue",
    srcs = ["cubemx_glue.c"],
    visibility = ["//tools/firmware:__pkg__"],
)

# Satisfies the `#include "cmsis_os.h"` in CubeMX-generated main.c without
# boards tracking CubeMX's CMSIS-RTOS2 wrapper headers. Wired in by
# firmware_project(enable_freertos = True); see cubemx_stub/cmsis_os.h.
cc_library(
    name = "cmsis_os_stub",
    hdrs = ["cubemx_stub/cmsis_os.h"],
    strip_include_prefix = "cubemx_stub",
    visibility = ["//tools/firmware:__pkg__"],
)

cc_library(
    name = "host",
    srcs = [
        "hooks.c",
        "@freertos_kernel//:freertos_kernel_srcs",
        "@freertos_kernel//:heap_3",
    ] + select({
        "@platforms//os:windows": ["@freertos_kernel//:windows_port_srcs"],
        "//conditions:default": ["@freertos_kernel//:posix_port_srcs"],
    }),
    hdrs = ["host/FreeRTOSConfig.h"],
    copts = select({
        "@platforms//os:windows": [],
        "//conditions:default": ["-pthread"],
    }),
    includes = ["host"],
    linkopts = select({
        "@platforms//os:windows": ["-lwinmm"],
        "//conditions:default": ["-pthread"],
    }),
    # Host-only: firmware compiles the kernel inside the firmware binary
    # against the board's own FreeRTOSConfig.h.
    target_compatible_with = select({
        "@platforms//os:none": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    visibility = ["//visibility:public"],
    deps = ["@freertos_kernel//:freertos_kernel_headers"] + select({
        "@platforms//os:windows": ["@freertos_kernel//:windows_port_headers"],
        "//conditions:default": ["@freertos_kernel//:posix_port_headers"],
    }),
)

cc_test(
    name = "host_smoke_test",
    size = "small",
    srcs = ["host_smoke_test.cpp"],
    deps = [
        ":host",
        "@googletest//:gtest_main",
    ],
)

