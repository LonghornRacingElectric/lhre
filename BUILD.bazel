# Root package

# NOTE: remote execution now uses @buildbuddy_toolchain//:platform_linux_x86_64
# (see .bazelrc), whose container image ships the GCC matching the registered
# BuildBuddy C++ toolchain. The old //:rbe_linux platform (plain ubuntu:22.04,
# no compiler) was removed.

platform(
    name = "arm_none_eabi",
    constraint_values = [
        "@platforms//cpu:arm",
        "@platforms//os:none",
    ],
    visibility = ["//visibility:public"],
)

