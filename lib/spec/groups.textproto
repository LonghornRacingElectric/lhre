  group {
    name: "DiagnosticsLow"
    next_free_id: 18
    description: "Low-rate state, shutdown, and fault telemetry."
    snapshot_id: 7
  }
  group {
    name: "Dynamics"
    next_free_id: 37
    description: "Vehicle motion and suspension telemetry."
    snapshot_id: 3
    external_field {
      name: "gps"
      id: 1
      type: PROTO_FLOAT
      repeated: true
      description: "NMEA latitude and longitude populated by the gateway."
      unit: "deg"
      element_names: "latitude"
      element_names: "longitude"
    }
    external_field {
      name: "gps_imu"
      id: 2
      type: PROTO_FLOAT
      repeated: true
      description: "NMEA inertial vector populated by the gateway."
      element_names: "x"
      element_names: "y"
      element_names: "z"
    }
    external_field {
      name: "gps_speed"
      id: 3
      type: PROTO_FLOAT
      description: "NMEA ground speed populated by the gateway."
      unit: "knots"
    }
    external_field {
      name: "gps_precise"
      id: 36
      type: PROTO_DOUBLE
      repeated: true
      description: "ChudPi\'s full-precision position from $PPOS: lat deg, lon deg, ellipsoid height m, 1-sigma horizontal error m, source (1 standard, 2 RTK), fix time Unix s. Double because float keeps lat/lon only to about 0.4 m. Empty while ChudPi has no solution."
      element_names: "latitude"
      element_names: "longitude"
      element_names: "height_m"
      element_names: "sigma_h_m"
      element_names: "source"
      element_names: "fix_time_s"
    }
  }
  group {
    name: "Pack"
    next_free_id: 23
    description: "Accumulator and inverter electrical telemetry."
    snapshot_id: 5
  }
  group {
    name: "Thermal"
    next_free_id: 39
    description: "Temperatures, cooling, and charger telemetry."
    snapshot_id: 8
  }
