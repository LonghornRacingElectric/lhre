      id: 4
      type: PROTO_FLOAT
      description: "Seconds since the gateway received an inverter frame."
    }
    external_field {
      name: "pdu_last_seen_s"
      id: 5
      type: PROTO_FLOAT
      description: "Seconds since the gateway received a PDU frame."
    }
    external_field {
      name: "tsm_last_seen_s"
      id: 6
      type: PROTO_FLOAT
      description: "Seconds since the gateway received a TSM frame."
    }
    external_field {
      name: "usm_last_seen_s"
      id: 7
      type: PROTO_FLOAT
      description: "Seconds since the gateway received a USM frame."
    }
    external_field {
      name: "vcu_last_seen_s"
      id: 8
      type: PROTO_FLOAT
      description: "Seconds since the gateway received a VCU frame."
    }
  }
  group {
    name: "Controls"
    next_free_id: 46
    reserved_ids: 31
    reserved_ids: 32
    reserved_ids: 33
    reserved_ids: 34
    reserved_ids: 35
    reserved_ids: 36
    reserved_ids: 37
    reserved_ids: 38
