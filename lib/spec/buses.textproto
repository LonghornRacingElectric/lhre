# proto-file: lib/spec/proto/can_spec.proto
# proto-message: lhre.canspec.SpecFile

bus {
  name: "Critical"
  bitrate_bps: 1000000
  description: "Primary vehicle bus: VCU, inverter, HVC, PDU, dash. VCU Rev A: FDCAN2 (PB12/PB13)."
}
bus {
  name: "Data"
  bitrate_bps: 1000000
  description: "Data acquisition bus (last year \"Data Acq\"): sensor nodes, VCU diagnostics. VCU Rev A: FDCAN1 (PD0/PD1)."
}
