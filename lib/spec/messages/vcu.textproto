message {
  name: "VCU_FAULTS"
  can_id: 459
  from_board: "VCU"
  to_boards: "DUI"
  to_boards: "Pi"
  bus: "Critical"
  dlc: 8
  frequency_hz: 10.0
  description: "Active VCU faults for the dash. Brake comparator faults stay latched until DUI_DRIVER_INPUTS.fault_reset."
  signal {
    name: "active_faults"
    encoding {
      bit_length: 32
    }
    logical {
      bitfield {
        bitfield_type: "VcuFaultBits"
      }
    }
    description: "Active faults"
  }
  signal {
    name: "primary_fault"
    encoding {
      start_bit: 32
      bit_length: 8
    }
    logical {
      enum_type: "VcuFaultCode"
    }
    description: "Highest-priority active fault"
  }
  signal {
    name: "state"
