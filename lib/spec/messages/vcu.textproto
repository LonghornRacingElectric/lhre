    encoding {
      start_bit: 32
      bit_length: 1
    }
    logical {
      boolean: true
    }
    telemetry {
      group: "Controls"
      field: "direction"
      id: 26
    }
    description: "direction"
  }
  signal {
    name: "enable"
    encoding {
      start_bit: 40
      bit_length: 1
    }
    logical {
      boolean: true
    }
    telemetry {
      group: "Controls"
      field: "enable"
      id: 27
    }
    description: "enable"
  }
  signal {
    name: "torque_limit"
    encoding {
      start_bit: 48
      bit_length: 16
      sign: SIGNED
      scale: 0.1
    }
    logical {
      physical {
        unit: "Nm"
      }
    }
    telemetry {
      group: "Controls"
      field: "torque_limit"
      id: 22
    }
    description: "torque limit"
  }
}
