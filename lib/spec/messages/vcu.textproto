      id: 27
    }
    description: "enable"
  }
  signal {
    name: "torque_limit"
    encoding {
      start_bit: 48
      bit_length: 16
      sign: SIGNED
      scale: 0.1
    }
    logical {
      physical {
        unit: "Nm"
      }
    }
    telemetry {
      group: "Controls"
      field: "torque_limit"
      id: 22
    }
    description: "torque limit"
  }
}
