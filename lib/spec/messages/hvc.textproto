# proto-file: lib/spec/proto/can_spec.proto
# proto-message: lhre.canspec.SpecFile

message {
  name: "HVC_CHARGER_COMMAND"
  can_id: 80
  from_board: "HVC"
  to_boards: "Charger"
  bus: "Critical"
  dlc: 7
  frequency_hz: 10.0
  description: "HVC Charger Command"
  signal {
    name: "max_charge_voltage"
    encoding {
      bit_length: 16
      scale: 0.01
    }
    logical {
      physical {
        unit: "V"
      }
    }
    telemetry {
      group: "Thermal"
      field: "max_charge_voltage"
      id: 36
    }
    description: "Max Charge Voltage"
  }
  signal {
    name: "max_charge_current"
    encoding {
      start_bit: 16
      bit_length: 16
      scale: 0.01
    }
    logical {
      physical {
        unit: "A"
      }
    }
    telemetry {
      group: "Thermal"
      field: "max_charge_current"
      id: 35
    }
    description: "Max Charge Current"
  }
  signal {
    name: "imd_led_state"
    encoding {
      start_bit: 32
      bit_length: 1
    }
    logical {
      boolean: true
    }
    telemetry {
      group: "DiagnosticsLow"
      field: "imd_led"
      id: 17
    }
    description: "IMD LED State"
  }
  signal {
    name: "bms_led_state"
    encoding {
      start_bit: 40
      bit_length: 1
    }
    logical {
      boolean: true
    }
    telemetry {
      group: "Thermal"
      field: "bms_led"
      id: 37
    }
    description: "BMS LED State"
  }
  signal {
    name: "charger_enable"
    encoding {
      start_bit: 48
      bit_length: 1
    }
    logical {
      boolean: true
    }
    telemetry {
      group: "Thermal"
      field: "charger_enable"
      id: 38
    }
    description: "Charger Enable"
  }
}
message {
  name: "CELL_VOLTAGES"
  can_id: 208
  quantity: 33
  from_board: "HVC"
  to_boards: "PDU"
  bus: "Critical"
  dlc: 8
  frequency_hz: 1.0
  description: "Cell Voltages. Orion has 130 cells: 33 frames x 4 cells/frame = 132 slots (last 2 unused). (Packet 1 is 0x0D0, Packet 33 is 0x0F0)"
  signal {
    name: "voltage_i"
    encoding {
      bit_length: 16
      scale: 0.0001
    }
    logical {
      physical {
        unit: "V"
      }
    }
    telemetry {
      group: "Pack"
      field: "cells_v"
      id: 4
      repeated: true
    }
    description: "Voltage[i]"
  }
  signal {
    name: "voltage_i_1"
    encoding {
      start_bit: 16
      bit_length: 16
      scale: 0.0001
    }
    logical {
      physical {
        unit: "V"
      }
    }
    telemetry {
      group: "Pack"
      field: "cells_v"
      id: 4
      array_index: 1
      repeated: true
    }
    description: "Voltage[i+1]"
  }
  signal {
    name: "voltage_i_2"
    encoding {
      start_bit: 32
      bit_length: 16
      scale: 0.0001
    }
    logical {
      physical {
        unit: "V"
      }
    }
    telemetry {
      group: "Pack"
      field: "cells_v"
      id: 4
      array_index: 2
      repeated: true
    }
    description: "Voltage[i+2]"
  }
  signal {
    name: "voltage_i_3"
    encoding {
      start_bit: 48
      bit_length: 16
      scale: 0.0001
    }
    logical {
      physical {
        unit: "V"
      }
    }
    telemetry {
      group: "Pack"
      field: "cells_v"
      id: 4
      array_index: 3
      repeated: true
    }
    description: "Voltage[i+3]"
  }
}
message {
