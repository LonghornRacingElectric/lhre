# proto-file: lib/spec/proto/can_spec.proto
# proto-message: lhre.canspec.SpecFile

message {
  name: "INVERTER_MOTOR_POSITION"
  can_id: 165
  from_board: "Inverter"
  to_boards: "VCU"
  bus: "Critical"
  dlc: 8
  frequency_hz: 100.0
  description: "Cascadia motor position information."
  signal {
    name: "motor_angle"
    encoding {
      bit_length: 16
      sign: SIGNED
      scale: 0.1
    }
    logical {
      physical {
        unit: "deg"
      }
    }
    description: "Electrical motor angle"
  }
  signal {
    name: "motor_speed"
    encoding {
      start_bit: 16
      bit_length: 16
      sign: SIGNED
    }
    logical {
      physical {
        unit: "rpm"
      }
    }
    description: "Motor speed"
  }
  signal {
    name: "electrical_frequency"
    encoding {
      start_bit: 32
      bit_length: 16
      sign: SIGNED
      scale: 0.1
    }
    logical {
      physical {
        unit: "Hz"
      }
    }
    description: "Electrical output frequency"
  }
  signal {
    name: "delta_resolver_filtered"
    encoding {
      start_bit: 48
      bit_length: 16
      sign: SIGNED
      scale: 0.1
    }
    logical {
      physical {
        unit: "deg"
      }
    }
    description: "Delta resolver angle"
  }
}
message {
  name: "INVERTER_CURRENT"
  can_id: 166
  from_board: "Inverter"
  to_boards: "VCU"
  bus: "Critical"
  dlc: 8
  frequency_hz: 10.0
  description: "Cascadia current information."
  signal {
    name: "phase_a_current"
    encoding {
      bit_length: 16
      sign: SIGNED
      scale: 0.1
    }
    logical {
      physical {
        unit: "A"
      }
    }
    description: "Phase A current"
  }
  signal {
    name: "phase_b_current"
    encoding {
      start_bit: 16
      bit_length: 16
      sign: SIGNED
      scale: 0.1
    }
    logical {
      physical {
        unit: "A"
      }
    }
    description: "Phase B current"
  }
  signal {
    name: "phase_c_current"
    encoding {
      start_bit: 32
      bit_length: 16
      sign: SIGNED
      scale: 0.1
    }
    logical {
      physical {
        unit: "A"
      }
    }
    description: "Phase C current"
  }
  signal {
    name: "dc_bus_current"
    encoding {
      start_bit: 48
      bit_length: 16
      sign: SIGNED
      scale: 0.1
    }
    logical {
      physical {
        unit: "A"
      }
    }
    description: "DC bus current (negative = regen)"
  }
}
