message {
  name: "INVERTER_HIGH_SPEED"
  can_id: 176
  from_board: "Inverter"
  to_boards: "VCU"
  bus: "Critical"
  dlc: 8
  frequency_hz: 333.0
  description: "Cascadia fast message: torque, speed, DC bus voltage."
  signal {
