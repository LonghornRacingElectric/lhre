message {
  name: "SWITCH_OUTPUTS"
  can_id: 324
  from_board: "PDU"
  to_boards: "VCU"
  bus: "Critical"
  dlc: 2
  frequency_hz: 10.0
  description: "Switch Outputs"
  signal {
    name: "switch_output"
    encoding {
      bit_length: 8
    }
    logical {
      bitfield {
        bitfield_type: "SwitchOutput"
      }
    }
    description: "Switch Output"
  }
}
message {
  name: "BATTERY_COOLING"
  can_id: 385
  from_board: "PDU"
  to_boards: "Pi"
  bus: "Critical"
  dlc: 6
  frequency_hz: 10.0
  description: "Battery Cooling"
  signal {
    name: "temp_after_battery"
    encoding {
      bit_length: 16
      sign: SIGNED
      scale: 0.01
    }
    logical {
      physical {
        unit: "degC"
      }
    }
    telemetry {
      group: "Thermal"
      field: "batt_loop_batt_temp"
      id: 5
    }
    description: "Temp After Battery"
  }
  signal {
    name: "temp_after_radiator"
    encoding {
      start_bit: 16
      bit_length: 16
      sign: SIGNED
      scale: 0.01
    }
    logical {
      physical {
        unit: "degC"
      }
    }
    telemetry {
      group: "Thermal"
      field: "batt_loop_rad_temp"
      id: 7
    }
    description: "Temp After Radiator"
  }
  signal {
    name: "radiator_fan_speed"
    encoding {
      start_bit: 32
      bit_length: 16
      scale: 0.2
    }
    logical {
      physical {
        unit: "rpm"
      }
    }
    telemetry {
      group: "Thermal"
      field: "batt_loop_rad_fan_speed"
      id: 6
    }
    description: "Radiator Fan Speed"
  }
}
