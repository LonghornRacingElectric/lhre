message {
  name: "FL_ACCEL_RIDE_HEIGHT"
  can_id: 1280
  from_board: "CSM"
  to_boards: "Pi"
  bus: "Data Acq"
  dlc: 8
  frequency_hz: 100.0
  description: "FL Accel + Ride Height"
  signal {
    name: "x"
    encoding {
      bit_length: 16
      sign: SIGNED
      scale: 0.001
    }
    logical {
      physical {
        unit: "m/s^2"
      }
    }
    telemetry {
      group: "Dynamics"
      field: "fl_sprung_accel"
      id: 19
      repeated: true
    }
    description: "X"
  }
  signal {
    name: "y"
    encoding {
      start_bit: 16
      bit_length: 16
      sign: SIGNED
      scale: 0.001
    }
    logical {
      physical {
        unit: "m/s^2"
      }
    }
    telemetry {
      group: "Dynamics"
      field: "fl_sprung_accel"
      id: 19
      array_index: 1
      repeated: true
    }
    description: "Y"
  }
  signal {
    name: "z"
    encoding {
      start_bit: 32
      bit_length: 16
      sign: SIGNED
      scale: 0.001
    }
    logical {
      physical {
        unit: "m/s^2"
      }
    }
    telemetry {
      group: "Dynamics"
      field: "fl_sprung_accel"
      id: 19
      array_index: 2
      repeated: true
    }
    description: "Z"
  }
  signal {
    name: "ride_height"
    encoding {
      start_bit: 48
      bit_length: 16
      scale: 0.002
    }
    logical {
      physical {
        unit: "mm"
      }
    }
    telemetry {
      group: "Dynamics"
      field: "fl_ride_height"
      id: 28
    }
    description: "Ride Height"
  }
}
