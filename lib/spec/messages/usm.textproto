message {
  name: "WHEEL_SPEED_RIDE_HEIGHT"
  can_id: 304
  from_board: "USM"
  to_boards: "VCU"
  bus: "Critical"
  dlc: 4
  frequency_hz: 10.0
  description: "Wheel Speed, Ride height"
  signal {
    name: "wheel_speed"
    encoding {
      bit_length: 16
      sign: SIGNED
      scale: 0.0078125
    }
    logical {
      physical {
        unit: "rad/s"
      }
    }
    telemetry {
      group: "Dynamics"
      field: "wheel_speed"
      id: 35
    }
    description: "Wheel Speed"
  }
  signal {
    name: "ride_height"
    encoding {
      start_bit: 16
      bit_length: 16
      scale: 0.0625
    }
    logical {
      physical {
        unit: "mm"
      }
    }
    telemetry {
      group: "Dynamics"
      field: "ride_height"
      id: 34
    }
    description: "Ride Height"
  }
}
