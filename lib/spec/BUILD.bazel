"""The CAN spec: source of truth for every message on the bus.

The .textproto files here are the spec. ir/ holds the Python that reads,
validates, and serializes them; nothing else understands the format.

    //lib/spec:files          all spec .textproto files
    //lib/spec:ir             loader, validator, canonical serializer, wire types
    //lib/spec:validate       py_test enforcing the semantic invariants
    //lib/spec:format_check   py_test: files match canonical serialization
    //lib/spec:wire_lock_test py_test: wire.lock matches the spec
"""

load("@rules_python//python:defs.bzl", "py_library", "py_test")

filegroup(
    name = "files",
    srcs = glob([
        "*.textproto",
        "messages/*.textproto",
    ]),
    visibility = ["//visibility:public"],
)

py_library(
    name = "ir",
    srcs = [
        "ir/canonical.py",
        "ir/loader.py",
        "ir/validator.py",
        "ir/wire.py",
    ],
    visibility = ["//visibility:public"],
    deps = ["//lib/spec/proto:can_spec_py_proto"],
)

py_test(
    name = "validate",
    size = "small",
    srcs = ["ir/validate.py"],
    args = ["$(rlocationpaths :files)"],
    data = [":files"],
    main = "ir/validate.py",
    deps = [
        ":ir",
        "@lhre_pypi//bazel_runfiles",
    ],
)

py_test(
    name = "format_check",
    size = "small",
    srcs = ["ir/format_check.py"],
    args = ["$(rlocationpaths :files)"],
    data = [":files"],
    main = "ir/format_check.py",
    deps = [
        ":ir",
        "@lhre_pypi//bazel_runfiles",
    ],
)

# The committed wire contract (field numbers + derived proto types) must
# match the spec. Update with `bazel run //tools/spec:lock`.
py_test(
    name = "wire_lock_test",
    size = "small",
    srcs = ["ir/wire_lock_test.py"],
    args = ["$(rlocationpaths :files)"] + ["$(rlocationpath wire.lock)"],
    data = [
        "wire.lock",
        ":files",
    ],
    main = "ir/wire_lock_test.py",
    deps = [
        ":ir",
        "@lhre_pypi//bazel_runfiles",
    ],
)

py_test(
    name = "validator_test",
    size = "small",
    srcs = ["ir/validator_test.py"],
    main = "ir/validator_test.py",
    deps = [":ir"],
)

py_test(
    name = "wire_test",
    size = "small",
    srcs = ["ir/wire_test.py"],
    main = "ir/wire_test.py",
    deps = [":ir"],
)
