"""Generated CAN pack/unpack libraries for firmware.

One cc_library per source board — //lib/codegen/cpp:can_<board>, holding
lhre_can_<board>.hpp with everything in namespace lhre::can::<board> —
plus :can_types (shared enums + message metadata) and the :can_lib
umbrella that pulls in the whole bus. Boards should depend on the
per-board libraries for exactly the message sets they send or listen to.
"""

load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")
load("@rules_python//python:defs.bzl", "py_binary")
load(":can_lib.bzl", "can_lib_sources")

# Must match the lib/spec/messages/*.textproto file stems; the generator
# errors with instructions when a board file is added or removed.
CAN_BOARDS = [
    "hvc",
    "vcu",
]

py_binary(
    name = "gen_can_lib",
    srcs = ["gen_can_lib.py"],
    visibility = ["//visibility:private"],
    deps = ["//lib/spec:ir"],
)

can_lib_sources(
    name = "can_lib_srcs",
    boards = CAN_BOARDS,
    spec = "//lib/spec:files",
)

cc_library(
    name = "can_types",
    srcs = ["lhre_can_types.cpp"],
    hdrs = ["lhre_can_types.hpp"],
    includes = ["."],
    visibility = ["//visibility:public"],
)

[
    cc_library(
        name = "can_" + board,
        srcs = ["lhre_can_{}.cpp".format(board)],
        hdrs = ["lhre_can_{}.hpp".format(board)],
        includes = ["."],
        visibility = ["//visibility:public"],
        deps = [
            ":can_types",
            "//drivers/lhal:lhal",
        ],
    )
    for board in CAN_BOARDS
]

# Everything on the bus at once — tests, sims, and the future gateway.
# Firmware should prefer the per-board targets above.
cc_library(
    name = "can_lib",
    hdrs = ["lhre_can.hpp"],
    includes = ["."],
    visibility = ["//visibility:public"],
    deps = [":can_types"] + [":can_" + board for board in CAN_BOARDS],
)

cc_test(
    name = "can_lib_test",
    size = "small",
    srcs = ["test/can_lib_test.cpp"],
    deps = [
        ":can_lib",
        "@googletest//:gtest_main",
    ],
)
