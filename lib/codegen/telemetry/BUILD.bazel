"""Server-side artifacts generated from //lib/spec."""

load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")
load("@protobuf//bazel:proto_library.bzl", "proto_library")
load("@telemetry_stack_reqs//:requirements.bzl", "requirement")
load(":telemetry_artifact.bzl", "telemetry_artifact")

py_library(
    name = "catalog_lib",
    srcs = ["catalog.py"],
    visibility = ["//visibility:public"],
)

py_library(
    name = "gen_telemetry_lib",
    visibility = ["//apps/telemetry/stack/ingest:__pkg__"],
    srcs = ["gen_telemetry.py", "storage.py"],
    deps = [
        ":catalog_lib",
        "//lib/spec:ir",
        "//lib/telemetry:contract",
        "//apps/telemetry/scripts:schema_helpers",
    ],
)

py_binary(
    name = "gen_telemetry",
    srcs = ["gen_telemetry.py"],
    visibility = ["//visibility:private"],
    deps = [":gen_telemetry_lib"],
)

telemetry_artifact(
    name = "can_packets_proto",
    kind = "proto",
    out = "can_packets.proto",
    spec = "//lib/spec:files",
    visibility = ["//visibility:public"],
)

telemetry_artifact(
    name = "can_json",
    kind = "can_json",
    out = "can.json",
    spec = "//lib/spec:files",
    visibility = ["//visibility:public"],
)

telemetry_artifact(
    name = "signals_json",
    kind = "signals_json",
    out = "signals.json",
    spec = "//lib/spec:files",
    visibility = ["//visibility:public"],
)

telemetry_artifact(
    name = "orion_db_init",
    common_sql = "//apps/telemetry/stack/ingest:common_schema.sql",
    kind = "sql",
    out = "orion_db_init.sql",
    spec = "//lib/spec:files",
    visibility = ["//visibility:public"],
)

filegroup(
    name = "server_schema",
    srcs = [
        ":can_json",
        ":can_packets_proto",
        ":orion_db_init",
        ":schema_contract",
        ":schema_descriptor",
        ":orm_source",
        ":orion_prisma",
        ":artemis_schema",
        ":storage_contract",
        ":storage_sql",
        ":signals_json",
    ],
    visibility = ["//visibility:public"],
)

telemetry_artifact(
    name = "schema_contract",
    kind = "contract",
    out = "schema_contract.json",
    spec = "//lib/spec:files",
    visibility = ["//visibility:public"],
)

genrule(
    name = "schema_descriptor",
    srcs = [":can_packets_proto"],
    outs = ["schema_descriptor.pb"],
    cmd = "$(location //tools/protoc) --descriptor_set_out=$@ --proto_path=$$(dirname $(location :can_packets_proto)) $(location :can_packets_proto)",
    tools = ["//tools/protoc"],
    visibility = ["//visibility:public"],
)

proto_library(
    name = "orion_proto",
    srcs = [":can_packets_proto"],
    visibility = ["//visibility:public"],
)

telemetry_artifact(
    name = "orm_source",
    kind = "orm",
    out = "orion_models.py",
    spec = "//lib/spec:files",
)

py_library(
    name = "orion_models",
    srcs = [":orm_source"],
    deps = [requirement("SQLAlchemy")],
    visibility = ["//visibility:public"],
)

telemetry_artifact(
    name = "orion_prisma",
    kind = "prisma",
    out = "orion.prisma",
    common_sql = "//apps/telemetry/stack/ingest:common_schema.sql",
    spec = "//lib/spec:files",
    visibility = ["//visibility:public"],
)

py_test(
    name = "gen_telemetry_test",
    size = "small",
    srcs = ["gen_telemetry_test.py"],
    args = ["$(rlocationpaths //lib/spec:files)"],
    data = ["//lib/spec:files"],
    deps = [
        ":catalog_lib",
        ":gen_telemetry_lib",
        "@lhre_pypi//bazel_runfiles",
    ],
)

py_test(
    name = "generated_contract_test",
    size = "small",
    srcs = ["generated_contract_test.py"],
    args = ["$(rootpath :schema_contract)", "$(rootpath //lib/spec:wire.lock)"],
    data = [":schema_contract", ":server_schema", "//lib/spec:wire.lock"],
    deps = [
        "//lib/spec:ir",
        "//lib/telemetry:contract",
        ":artemis_models",
        "//apps/telemetry/scripts:schema_helpers",
    ],
)

telemetry_artifact(
    name = "storage_contract",
    car = "Artemis",
    kind = "storage",
    out = "storage_contract.json",
    spec = "//lib/spec:files",
    visibility = ["//visibility:public"],
)

telemetry_artifact(
    name = "storage_sql",
    car = "Artemis",
    kind = "storage_sql",
    out = "storage_update.sql",
    spec = "//lib/spec:files",
    visibility = ["//visibility:public"],
)

telemetry_artifact(
    name = "artemis_proto_source",
    kind = "proto",
    car = "Artemis",
    out = "artemis.proto",
    spec = "//lib/spec:files",
    visibility = ["//visibility:public"],
)

telemetry_artifact(
    name = "artemis_db_init",
    kind = "sql",
    car = "Artemis",
    out = "artemis_db_init.sql",
    common_sql = "//apps/telemetry/stack/ingest:common_schema.sql",
    spec = "//lib/spec:files",
    visibility = ["//visibility:public"],
)

telemetry_artifact(
    name = "artemis_orm_source",
    kind = "orm",
    car = "Artemis",
    out = "artemis_models.py",
    spec = "//lib/spec:files",
    visibility = ["//visibility:public"],
)

telemetry_artifact(
    name = "artemis_prisma",
    kind = "prisma",
    car = "Artemis",
    out = "artemis.prisma",
    common_sql = "//apps/telemetry/stack/ingest:common_schema.sql",
    spec = "//lib/spec:files",
    visibility = ["//visibility:public"],
)

telemetry_artifact(
    name = "artemis_schema_contract",
    kind = "contract",
    car = "Artemis",
    out = "artemis_schema_contract.json",
    spec = "//lib/spec:files",
    visibility = ["//visibility:public"],
)

py_library(
    name = "artemis_models",
    srcs = [":artemis_orm_source"],
    deps = [requirement("SQLAlchemy")],
    visibility = ["//visibility:public"],
)

proto_library(
    name = "artemis_proto",
    srcs = [":artemis_proto_source"],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "artemis_schema",
    srcs = [":artemis_proto_source", ":artemis_db_init", ":artemis_orm_source", ":artemis_prisma", ":artemis_schema_contract", ":storage_contract", ":storage_sql"],
    visibility = ["//visibility:public"],
)
