# Local telemetry database. ELECTRIC_PWD must match POSTGRES_PASSWORD because
# the Postgres container creates POSTGRES_USER as the electric service account.
POSTGRES_USER=electric
POSTGRES_DB=orion
POSTGRES_PASSWORD=local_dev_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

ELECTRIC_PWD=local_dev_password
GRAFANA_PWD=local_grafana_password
ANALYSIS_PWD=local_analysis_password

# Viewer authentication. Replace this value before using a shared deployment.
NEXTAUTH_SECRET=replace_with_a_random_secret
AUTH_DATABASE_URL=file:./dev.db

# Host-side Kafka clients use the published 29092 listener.
KAFKA_BROKERS=localhost:29092
KAFKA_CLIENT_ID=viewer-tool
KAFKA_GROUP_ID=viewer-tool-group
KAFKA_TOPICS=status
KAFKA_AUTO_CREATE=1
KAFKA_ROUTES_FILE=./kafka.routes.json
KAFKA_SENSOR_TOPIC=sensor_data

NEXT_PUBLIC_DEFAULT_LIVE_CAR=orion
NEXT_PUBLIC_VIEWER_MULTI_CAR=true

# Optional remote MQTT broker. Empty keeps the local Mosquitto path.
AWS_MQTT_IP=

# Optional logsync settings.
BEVO_SSH_TARGET=lhre@100.64.195.68
BEVO_LOG_DIR=Documents/lhre/lhre-2026/BEVO/loggerd/logs
LOGSYNC_SPEED_THRESHOLD_MPS=0.5
LOGSYNC_MOTION_STALENESS_MS=10000
LOGSYNC_DEFAULT_BWLIMIT_KBPS=0
LOGSYNC_URL=http://localhost:8090

# Persistent-storage selection belongs to the launcher environment, not this
# dotenv file. Production uses: export TELEMETRY_STORAGE_ROOT=/mnt/server_ssd
