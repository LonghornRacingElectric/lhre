+/* pthread_cond_wait() is a cancellation point: when vPortCancelThread()
+ * cancels a task suspended here, the mutex is re-acquired before the thread
+ * terminates (POSIX), so without a cleanup handler the thread dies holding
+ * ev->mutex and the canceller deadlocks in event_signal(). Observed with
+ * glibc when vTaskEndScheduler() deletes the idle/timer tasks. */
+static void event_cancel_unlock( void * mutex )
+{
+    pthread_mutex_unlock( ( pthread_mutex_t * ) mutex );
+}
