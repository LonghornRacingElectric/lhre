module(name = "lhre")

bazel_dep(name = "rules_cc", version = "0.2.22")
bazel_dep(name = "llvm", version = "0.8.16")
bazel_dep(name = "rules_python", version = "2.2.0")
bazel_dep(name = "aspect_bazel_lib", version = "2.21.1")
bazel_dep(name = "toolchains_arm_gnu", version = "1.1.0")
bazel_dep(name = "protobuf", version = "35.1")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_rust", version = "0.73.0")
bazel_dep(name = "rules_shell", version = "0.6.1")
bazel_dep(name = "rules_oci", version = "2.3.0")
bazel_dep(name = "rules_pkg", version = "1.3.0")
bazel_dep(name = "rules_go", version = "0.62.0")
bazel_dep(name = "gazelle", version = "0.51.3")
bazel_dep(name = "toolchains_buildbuddy", version = "0.0.4")

bazel_dep(name = "googletest", version = "1.17.0.bcr.2", dev_dependency = True)

git_override(
    module_name = "toolchains_arm_gnu",
    commit = "c217763672309e1115e4c4331404573c685492e4",
    remote = "https://github.com/LonghornRacingElectric/toolchains_arm_gnu.git",
)

arm_toolchain = use_extension("@toolchains_arm_gnu//:extensions.bzl", "arm_toolchain")
arm_toolchain.arm_none_eabi(version = "13.2.1")

# @arm_none_eabi provides //:objcopy for bin/hex outputs; the host-specific
# repos hold the actual gcc trees and are referenced by the per-CPU-variant
# toolchains defined in //toolchains (which bake in each variant's
# -mcpu/-mfpu/-mfloat-abi — the upstream @arm_none_eabi//toolchain:all
# toolchains carry no codegen flags, so they are not registered).
use_repo(
    arm_toolchain,
    "arm_none_eabi",
    "arm_none_eabi_darwin_arm64",
    "arm_none_eabi_darwin_x86_64",
    "arm_none_eabi_linux_aarch64",
    "arm_none_eabi_linux_x86_64",
    "arm_none_eabi_windows_x86_64",
)

register_toolchains("//toolchains:all")

# Python proto toolchain using the pip protobuf runtime instead of
# @protobuf//python. This is what keeps protobuf C++ out of the build
# entirely: the default runtime compiles protoc_minimal + abseil from
# source, which does not even compile on Windows (our hermetic clang
# targets MinGW; protobuf's io shims assume MSVC headers). Works with the
# prebuilt-protoc toolchain protobuf registers; both need proto toolchain
# resolution, enabled in .bazelrc. See toolchains/proto/BUILD.bazel.
register_toolchains("//toolchains/proto:all")

# Hermetic LLVM toolchain (hermeticbuild/hermetic-llvm): host-targeted C++
# (unit tests, sims, host tools) compiles with the same hermetic clang on
# every machine — no dependency on local Xcode / system GCC / MSVC.
# Registered before the BuildBuddy toolchain below so it is also preferred
# for Linux-targeted builds on the remote executors; the firmware toolchain
# above is unaffected (only it targets os:none).
register_toolchains("@llvm//toolchain:all")

# BuildBuddy RBE toolchain: provides a C++ toolchain that runs on (and targets)
# the Linux x86_64 remote executors, so host tools (e.g. py_binary's zipper)
# can be built remotely from any host OS. Its exec constraints are Linux-only,
# so it is never selected for local Windows/macOS builds.
buildbuddy = use_extension("@toolchains_buildbuddy//:extensions.bzl", "buildbuddy")
buildbuddy.platform(buildbuddy_container_image = "UBUNTU22_04_IMAGE")
use_repo(buildbuddy, "buildbuddy_toolchain")

register_toolchains("@buildbuddy_toolchain//:ubuntu_cc_toolchain")

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    is_default = True,
    python_version = "3.12",
)
use_repo(python, "python_3_12")

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    hub_name = "lhre_pypi",
    python_version = "3.12",
    requirements_lock = "//:requirements_lock.txt",
    # Evaluate the lock file for every platform we build on or execute on,
    # not just the host. Without this the wheel hub only supports the host
    # platform, which breaks remote execution (Linux exec platform) and
    # cross-platform flashing tools.
    target_platforms = [
        "linux_x86_64",
        "linux_aarch64",
        "osx_aarch64",
        "osx_x86_64",
        "windows_x86_64",
    ],
)
use_repo(pip, "lhre_pypi")

# apps/telemetry: one hub for the analysis/viewer side (per-OS locks, the
# webtool is developed on laptops) and one for the server stack (Linux only,
# it ships as container images). The locks were compiled on 3.11 and are
# served under 3.12 as-is: every pin has 3.12 wheels or is pure Python.
pip.parse(
    hub_name = "telemetry_reqs",
    python_version = "3.12",
    requirements_darwin = "//apps/telemetry/analysis:requirements_lock_darwin.txt",
    requirements_lock = "//apps/telemetry/analysis:requirements_lock.txt",
    requirements_windows = "//apps/telemetry/analysis:requirements_lock_windows.txt",
)
pip.parse(
    hub_name = "telemetry_stack_reqs",
    python_version = "3.12",
    requirements_lock = "//apps/telemetry/stack:requirements_lock.txt",
    # Stack binaries remain runnable on developer hosts, while OCI packaging
    # transitions their closure to Linux x86_64. Declare both sides so native
    # wheels resolve correctly in either configuration.
    target_platforms = [
        "linux_x86_64",
        "osx_aarch64",
        "osx_x86_64",
        "windows_x86_64",
    ],
)
use_repo(pip, "telemetry_reqs", "telemetry_stack_reqs")

# The Kafka bridge remains a Go module for editor and non-Bazel tooling, while
# Bazel owns its hermetic Linux binary and OCI image.
go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(version = "1.24.13")

go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//apps/telemetry/stack/kafka:go.mod")
use_repo(
    go_deps,
    "com_github_ibm_sarama",
    "org_golang_google_grpc",
    "org_golang_google_protobuf",
)

stm32g4_deps = use_extension("//drivers/stm32/stm32g4:deps.bzl", "stm32g4_deps")
use_repo(
    stm32g4_deps,
    "cmsis_core_stm32g4",
    "cmsis_device_stm32g4",
    "stm32g4xx_hal_driver",
)

# ST USB Device middleware (Core + CDC class), family-independent.
# See drivers/stm32/usb_device/BUILD.bazel.
usb_device_deps = use_extension("//drivers/stm32/usb_device:deps.bzl", "usb_device_deps")
use_repo(usb_device_deps, "stm32_usb_device_library")

# FreeRTOS kernel — one version for firmware (Cortex-M ports) and host
# tests/sims (POSIX/Windows simulator ports). See drivers/freertos/README.md.
freertos_deps = use_extension("//drivers/freertos:deps.bzl", "freertos_deps")
use_repo(freertos_deps, "freertos_kernel")

dfu = use_extension("//tools/dfu:dfu.bzl", "dfu")
use_repo(dfu, "dfu")

openocd = use_extension("//tools/openocd:openocd.bzl", "openocd")
use_repo(openocd, "openocd")

# SVD peripheral definitions for VS Code debugging, pinned per device in
# tools/debug/svd_lock.bzl (managed by tools/new_board.py).
svd = use_extension("//tools/debug:svd.bzl", "svd")
use_repo(svd, "stm32_svd")

# Bazel Compile Commands Extractor (helly25 fork)
bazel_dep(name = "hedron_compile_commands", dev_dependency = True)
git_override(
    module_name = "hedron_compile_commands",
    commit = "6eb3ff1de6445355552ef4230be0caf3e1dd27e5",
    patch_strip = 1,
    # Windows: multiprocessing's spawn start method re-imports the extractor's
    # entry point in every worker, re-entering main() and killing the process
    # pool ("BrokenProcessPool"). Guard the entry point with __main__.
    patches = ["//patches:hedron_windows_spawn_guard.patch"],
    remote = "https://github.com/helly25/bazel-compile-commands-extractor.git",
)

# Prebuilt protoc binaries. Building @protobuf//:protoc from source drags in
# all of abseil (~800 C++ actions), and protobuf's own prebuilt-protoc
# machinery is broken in every BCR version available today — see
# tools/protoc/protoc.bzl. //tools/protoc is the per-exec-platform alias.
protoc_prebuilt = use_extension("//tools/protoc:protoc.bzl", "protoc")
use_repo(
    protoc_prebuilt,
    "protoc_linux_aarch_64",
    "protoc_linux_x86_64",
    "protoc_osx_aarch_64",
    "protoc_osx_x86_64",
    "protoc_win64",
)

# Hermetic Rust toolchain for the host-side telemetry daemons (apps/BEVO).
# The extra Linux target triples cover the remote test executors (x86_64,
# glibc) and the on-car Raspberry Pi (aarch64, musl → fully static binaries,
# so deploys can't hit glibc version skew on the Pi — see //platforms:pi).
# Std libs for unused triples never fetch.
rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = "2021",
    extra_target_triples = [
        "x86_64-unknown-linux-gnu",
        "aarch64-unknown-linux-musl",
    ],
    versions = ["1.85.0"],
)
use_repo(rust, "rust_toolchains")

register_toolchains("@rust_toolchains//:all")

# Third-party crates, resolved from apps/BEVO's Cargo manifest + committed
# Cargo.lock (single source of truth shared with cargo/rust-analyzer). After
# editing Cargo.toml: CARGO_BAZEL_REPIN=1 bazel build //apps/BEVO/... repins.
crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")
crate.from_cargo(
    name = "crates",
    cargo_lockfile = "//apps/BEVO:Cargo.lock",
    manifests = ["//apps/BEVO:Cargo.toml"],
)
use_repo(crate, "crates")

# Pinned Linux/AMD64 images used by the telemetry stack. Bazel resolves these
# manifests during the build; Compose only consumes the tags loaded locally by
# the corresponding `*_load` targets.
oci = use_extension("@rules_oci//oci:extensions.bzl", "oci")
oci.pull(
    name = "python312",
    digest = "sha256:47ae396f09c1303b8653019811a8498470603d7ffefc29cb07c88f1f8cb3d19f",
    image = "docker.io/library/python",
    platforms = ["linux/amd64"],
)
oci.pull(
    name = "telemetry_mosquitto",
    digest = "sha256:d12c8f80dfc65b768bb9acecc7ef182b976f71fb681640b66358e5e0cf94e9e9",
    image = "docker.io/library/eclipse-mosquitto",
    platforms = ["linux/amd64"],
)
oci.pull(
    name = "telemetry_postgres",
    digest = "sha256:67f41722b7a8cbdb868a44a4995c846eddfdc2973bccb291ce937dce88ad5675",
    image = "docker.io/library/postgres",
    platforms = ["linux/amd64"],
)
oci.pull(
    name = "telemetry_kafka",
    digest = "sha256:bff074a5d0051dbc0bbbcd25b045bb1fe84833ec0d3c7c965d1797dd289ec88f",
    image = "docker.io/apache/kafka",
    platforms = ["linux/amd64"],
)
oci.pull(
    name = "telemetry_grafana",
    digest = "sha256:a0f881232a6fb71a0554a47d0fe2203b6888fe77f4cefb7ea62bed7eb54e13c3",
    image = "docker.io/grafana/grafana-oss",
    platforms = ["linux/amd64"],
)
use_repo(
    oci,
    "python312",
    "python312_linux_amd64",
    "telemetry_grafana",
    "telemetry_grafana_linux_amd64",
    "telemetry_kafka",
    "telemetry_kafka_linux_amd64",
    "telemetry_mosquitto",
    "telemetry_mosquitto_linux_amd64",
    "telemetry_postgres",
    "telemetry_postgres_linux_amd64",
)
