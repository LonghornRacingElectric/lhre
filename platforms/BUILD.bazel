# Target platforms for STM32 firmware, one per chip family.
#
# Each platform carries the CPU-core constraint that selects the matching
# arm-none-eabi toolchain in //toolchains, where the family's codegen flags
# (-mcpu/-mfpu/-mfloat-abi) are baked in. Plain cc_library targets therefore
# compile correctly for both host and MCU with no per-target flag plumbing.
#
# Adding a family: pick (or add) the CPU-core constraint + toolchain for its
# core, add a platform here, and map it in FAMILY_PLATFORMS in
# //tools/firmware:firmware_project.bzl.

package(default_visibility = ["//visibility:public"])

# CPU core + FPU configuration of the MCU. Distinct from @platforms//cpu
# because both cortex-m4f and cortex-m7f are armv7e-m with hard float, yet
# need different -mcpu/-mfpu flags.
constraint_setting(name = "mcu_core")

constraint_value(
    name = "cortex_m0",
    constraint_setting = ":mcu_core",
)

constraint_value(
    name = "cortex_m4f",
    constraint_setting = ":mcu_core",
)

constraint_value(
    name = "cortex_m7f",
    constraint_setting = ":mcu_core",
)

platform(
    name = "stm32f0",
    constraint_values = [
        "@platforms//cpu:arm",
        "@platforms//os:none",
        ":cortex_m0",
    ],
)

platform(
    name = "stm32f4",
    constraint_values = [
        "@platforms//cpu:arm",
        "@platforms//os:none",
        ":cortex_m4f",
    ],
)

platform(
    name = "stm32g4",
    constraint_values = [
        "@platforms//cpu:arm",
        "@platforms//os:none",
        ":cortex_m4f",
    ],
)

platform(
    name = "stm32h7",
    constraint_values = [
        "@platforms//cpu:arm",
        "@platforms//os:none",
        ":cortex_m7f",
    ],
)

# The auto-detected host platform, plus a hard "never execute remotely"
# property. Used as --host_platform on Linux/macOS (.bazelrc): the remote
# executors are Linux x86_64, so any action whose exec platform resolves to
# the *host* (e.g. rules_rust building host-targeted crates and their
# bootstrap tools on a Mac) must run on this machine — without this, Bazel
# happily ships Mach-O tool binaries to the Linux executors, which fail with
# cryptic "Syntax error" messages from the executor's shell.
platform(
    name = "host_no_remote_exec",
    exec_properties = {"no-remote-exec": "1"},
    parents = ["@platforms//host"],
)

# The on-car telemetry computer (Raspberry Pi 4/5, 64-bit). Rust resolves
# this to the aarch64-unknown-linux-musl toolchain (the only aarch64-linux
# triple configured in MODULE.bazel), producing fully static binaries that
# run on any Pi OS image regardless of its glibc. See apps/BEVO/README.md
# for the deploy flow.
platform(
    name = "pi",
    constraint_values = [
        "@platforms//cpu:arm64",
        "@platforms//os:linux",
    ],
)

# Container target platform. Image rules transition their application binaries
# here explicitly, so a macOS or Windows developer can build the same Linux
# artifact as CI without changing the target platform for the rest of the
# command line.
platform(
    name = "linux_amd64",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
)
