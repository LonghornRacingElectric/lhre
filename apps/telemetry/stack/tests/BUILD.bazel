# telemetry/stack/tests/BUILD.bazel
# Integration tests for the telemetry stack
# Tests communication between Docker containers and non-Docker scripts

load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")
load("@telemetry_reqs//:requirements.bzl", "requirement")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//apps/telemetry:compatibility.bzl", "NOT_WINDOWS")
load("//apps/telemetry:container.bzl", "telemetry_service_image")

package(default_visibility = ["//apps/telemetry:__subpackages__"])

# Common test utilities library
py_library(
    name = "test_utils",
    imports = ["../..", "../../.."],
    srcs = ["test_utils.py"],
    visibility = ["//visibility:public"],
    deps = [
        "//apps/telemetry/analysis:analysis_lib",
        "//apps/telemetry/stack/ingest:ingest_lib",
        requirement("kafka-python"),
        requirement("numpy"),
        requirement("paho-mqtt"),
        requirement("pandas"),
        requirement("protobuf"),
        requirement("psycopg2-binary"),
        requirement("python-dotenv"),
        requirement("requests"),
        requirement("SQLAlchemy"),
    ],
    target_compatible_with = NOT_WINDOWS,
)

# Stack test client - tests container communication
py_binary(
    name = "stack_test_client",
