# Export shell scripts and docker-compose files
exports_files([
    "run_integration_test.sh",
    "test_stack_client.py",
])

# Integration test target - uses shell script to manage Docker lifecycle
sh_test(
    name = "stack_integration_test",
    srcs = ["run_integration_test.sh"],
    args = ["$(rlocationpath //apps/telemetry:current_schema_sql)", "$(rlocationpath //apps/telemetry:new_car_schema_sql)"],
    data = [
        "//apps/telemetry:current_schema_sql",
        "//apps/telemetry:new_car_schema_sql",
        "//apps/telemetry/stack:orion_schema.sh",
        ":stack_test_client",
        "//apps/telemetry/stack/ingest:docker-compose.yml",
        "//apps/telemetry/stack/kafka:docker-compose.yml",
        "//apps/telemetry/stack/processors/gps_classifier:docker-compose.yml",
        "//apps/telemetry/stack/processors/kafka_base:docker-compose.yml",
        "//apps/telemetry/stack/processors/lap_timer:docker-compose.yml",
        "//apps/telemetry:config_files",
    ],
    tags = ["integration", "docker", "manual", "local"],
    target_compatible_with = NOT_WINDOWS,
)

# Test suite for all integration tests (requires Docker to be running)
