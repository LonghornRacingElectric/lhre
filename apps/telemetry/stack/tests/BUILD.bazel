# PDR measurements are opt-in: the default matrix includes hour-long workloads.
# Keep the hyphenated artifact directory out of Python import module names.
[
    py_binary(
        name = "pdr_" + mode,
        srcs = [
            "PDR-Benchmarks/" + mode + ".py",
            "PDR-Benchmarks/common.py",
            "PDR-Benchmarks/metrics.py",
            "PDR-Benchmarks/reads.py",
            "PDR-Benchmarks/traffic.py",
            "benchmark_query_gateway.py",
        ] if mode != "reads" else [
            "PDR-Benchmarks/reads.py",
            "PDR-Benchmarks/common.py",
            "benchmark_query_gateway.py",
        ],
        main = "PDR-Benchmarks/" + mode + ".py",
        imports = ["../..", "../../..", "PDR-Benchmarks"],
        deps = [
            "//apps/telemetry/analysis:analysis_lib",
            "//apps/telemetry/stack/ingest:sensor_decode",
            requirement("kafka-python"),
            requirement("paho-mqtt"),
            requirement("psycopg2-binary"),
            requirement("SQLAlchemy"),
        ],
        tags = ["manual"],
        target_compatible_with = NOT_WINDOWS,
    )
    for mode in ["reads", "ingest", "recent"]
]


py_binary(
    name = "pdr_probe_binary",
    srcs = ["PDR-Benchmarks/probe.py"],
    main = "PDR-Benchmarks/probe.py",
    deps = ["//apps/telemetry/stack/ingest:ingest_lib"],
    tags = ["manual"],
    target_compatible_with = NOT_WINDOWS,
)

telemetry_service_image(
    name = "pdr_probe",
    binary = ":pdr_probe_binary",
    base = "@python312_linux_amd64",
    repository = "lhre/pdr-ingest-probe",
    repo_tags = ["lhre/pdr-ingest-probe:local"],
    env = {"IN_DOCKER": "1", "PYTHONPATH": "/app", "PYTHONUNBUFFERED": "1"},
    tars = ["//apps/telemetry:runtime_config_tar", "//apps/telemetry:current_schema_tar"],
    workdir = "/app",
)

