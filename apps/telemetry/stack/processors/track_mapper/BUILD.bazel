load("@rules_python//python:defs.bzl", "py_binary")
load("@telemetry_stack_reqs//:requirements.bzl", "requirement")
load("//apps/telemetry:container.bzl", "telemetry_service_image")

package(default_visibility = ["//apps/telemetry:__subpackages__"])

exports_files(["docker-compose.yml"])

py_binary(
    name = "track_mapper_binary",
    srcs = ["main.py"],
    imports = ["../../..", "../../../.."],
    main = "main.py",
    deps = [
        "//apps/telemetry/stack/ingest:ingest_lib",
        requirement("kafka-python"),
    ],
    visibility = ["//visibility:public"],
)

telemetry_service_image(
    name = "track_mapper",
    base = "@python312_linux_amd64",
    binary = ":track_mapper_binary",
    env = {
        "PYTHONPATH": "/app",
        "PYTHONUNBUFFERED": "1",
    },
    repo_tags = [
        "lhre/telemetry-track-mapper:dev",
        "track-mapper:latest",
    ],
    repository = "ghcr.io/longhornracingelectric/telemetry-track-mapper",
    tars = ["//apps/telemetry:runtime_config_tar"],
    visibility = ["//visibility:public"],
    workdir = "/app/stack/processors/track_mapper",
)
