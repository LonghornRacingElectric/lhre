load("@rules_python//python:defs.bzl", "py_binary")
load("@telemetry_stack_reqs//:requirements.bzl", "requirement")
load("//apps/telemetry:compatibility.bzl", "NOT_WINDOWS")
load("//apps/telemetry:container.bzl", "telemetry_service_image")

package(default_visibility = ["//apps/telemetry:__subpackages__"])

exports_files(["docker-compose.yml"])

py_binary(
    name = "board_health_binary",
    srcs = ["main.py"],
    imports = ["../../..", "../../../.."],
    main = "main.py",
    deps = [
        "//apps/telemetry/stack/ingest:ingest_lib",
        requirement("kafka-python"),
        requirement("protobuf"),
    ],
    target_compatible_with = NOT_WINDOWS,
    visibility = ["//visibility:public"],
)

telemetry_service_image(
    name = "board_health",
    base = "@python312_linux_amd64",
    binary = ":board_health_binary",
    env = {
        "PYTHONPATH": "/app",
        "PYTHONUNBUFFERED": "1",
    },
    repo_tags = [
        "lhre/telemetry-board-health:dev",
        "board_health_processor:latest",
    ],
    repository = "ghcr.io/longhornracingelectric/telemetry-board-health",
    tars = ["//apps/telemetry:runtime_config_tar"],
    visibility = ["//visibility:public"],
    workdir = "/app/stack/processors/board_health",
)
