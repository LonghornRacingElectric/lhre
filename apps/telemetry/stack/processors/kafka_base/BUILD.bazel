# telemetry/stack/processors/kafka_base/BUILD.bazel
# BUILD file for the Kafka base consumer processor
# This is the base template for Kafka consumers that process sensor data

load("@rules_python//python:defs.bzl", "py_binary", "py_library")
load("@rules_python//python:pip.bzl", "compile_pip_requirements")
load("@rules_oci//oci:defs.bzl", "oci_image", "oci_push", "oci_load")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("@telemetry_reqs//:requirements.bzl", "requirement")

package(default_visibility = ["//apps/telemetry:__subpackages__"])

# Compile pip requirements
compile_pip_requirements(
    name = "kafka_base_requirements",
    src = "requirements.txt",
    requirements_txt = "requirements_lock.txt",
    python_version = "3.12",
    generate_hashes = False,
    tags = ["manual", "requirements"],
)

# Export configuration files
exports_files([
    "docker-compose.yml",
    "README.md",
    "requirements.txt",
    "requirements_lock.txt",
])

# Python library for the Kafka base consumer
py_library(
    name = "kafka_base_lib",
    target_compatible_with = ["@platforms//os:linux"],
    imports = ["../../..", "../../../.."],
    srcs = [
        "main.py",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//apps/telemetry/stack/ingest:ingest_lib",
        requirement("kafka-python"),
        requirement("paho-mqtt"),
    ],
)

# Python binary for the Kafka base consumer
py_binary(
    name = "kafka_base_binary",
    target_compatible_with = ["@platforms//os:linux"],
    imports = ["../../..", "../../../.."],
    srcs = ["main.py"],
    main = "main.py",
    visibility = ["//visibility:public"],
    deps = [
        ":kafka_base_lib",
    ],
)

# Package the processor application files
pkg_tar(
    name = "kafka_base_app_tar",
    srcs = [
        "main.py",
    ],
    package_dir = "/app/stack/processors/kafka_base",
    strip_prefix = ".",
)

# Package configuration files
pkg_tar(
    name = "config_tar",
    srcs = [
        "//apps/telemetry:config_files",
    ],
    package_dir = "/app",
)

# OCI image for the Kafka base consumer
oci_image(
    name = "kafka_base_image",
    base = "@python312_linux_amd64",
    tars = [
        ":kafka_base_app_tar",
        ":config_tar",
    ],
    entrypoint = ["python", "/app/stack/processors/kafka_base/main.py"],
    env = {
        "PYTHONPATH": "/app",
        "PYTHONUNBUFFERED": "1",
    },
    visibility = ["//visibility:public"],
    target_compatible_with = ["@platforms//os:linux"],
)

# Tarball for local Docker loading (use oci_load instead of oci_tarball)
oci_load(
    name = "kafka_base_tarball",
    image = ":kafka_base_image",
    repo_tags = ["kafka_consumer:latest"],
)

# Push target for container registry
oci_push(
    name = "kafka_base_push",
    image = ":kafka_base_image",
    repository = "ghcr.io/longhornracingelectric/telemetry-kafka-base",
)
