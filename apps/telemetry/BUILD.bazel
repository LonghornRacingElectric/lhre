# telemetry/BUILD.bazel
# Main BUILD file for the telemetry system
# Contains shared resources and aggregate targets for the entire telemetry stack
#
# Key targets:
#   - //telemetry:telemetry_images     - Build all Docker container images
#   - //telemetry:telemetry_all        - Build everything (Docker + non-Docker)
#   - //telemetry:telemetry_tests      - Run all telemetry tests
#   - //telemetry:telemetry_push       - Push all images to registry
#
# Usage:
#   bazel build //telemetry:telemetry_images    # Build all container images
#   bazel test //telemetry:telemetry_tests      # Run all tests
#   bazel run //telemetry:ingest_tarball        # Load ingest image to local Docker

load("@rules_python//python:defs.bzl", "py_library")
load("@rules_oci//oci:defs.bzl", "oci_push")

package(default_visibility = ["//apps/telemetry:__subpackages__"])

# Export the network configuration file for all telemetry services
exports_files([
    "net_configs.json",
    ".env.example",
])

# Environment configuration files for tests
# Uses glob() so .env is optional - CI uses env vars from secrets instead
# Local development uses .env file (copy from .env.example)
filegroup(
    name = "env_files",
    srcs = glob([".env"], allow_empty = True),
    visibility = ["//visibility:public"],
)

# Shared Python library containing common utilities used across telemetry
py_library(
    name = "telemetry_common",
    imports = [".", ".."],
    srcs = ["__init__.py"],
    visibility = ["//visibility:public"],
)

# Filegroup for all telemetry configuration files
filegroup(
    name = "config_files",
    srcs = [
        "net_configs.json",
    ],
    visibility = ["//visibility:public"],
)

# ============================================================================
# Docker Image Targets
# ============================================================================

# Aggregate target for all telemetry Docker images
filegroup(
    name = "telemetry_images",
    srcs = [
        "//apps/telemetry/stack/ingest:ingest_image",
        "//apps/telemetry/stack/processors/gps_classifier:gps_classifier_image",
        "//apps/telemetry/stack/processors/kafka_base:kafka_base_image",
        "//apps/telemetry/stack/processors/lap_timer:lap_timer_image",
    ],
    visibility = ["//visibility:public"],
)

# Aggregate target for all Docker tarballs (for local loading)
filegroup(
    name = "telemetry_tarballs",
    srcs = [
        "//apps/telemetry/stack/ingest:ingest_tarball",
        "//apps/telemetry/stack/processors/gps_classifier:gps_classifier_tarball",
        "//apps/telemetry/stack/processors/kafka_base:kafka_base_tarball",
        "//apps/telemetry/stack/processors/lap_timer:lap_timer_tarball",
    ],
    visibility = ["//visibility:public"],
)

# ============================================================================
# Comprehensive Build Targets
# ============================================================================

# Aggregate target for building the entire telemetry system
# This includes both Docker containers and non-Docker components
filegroup(
    name = "telemetry_all",
    srcs = [
        ":telemetry_images",
        ":config_files",
        "//apps/telemetry/analysis:analysis_lib",
        "//apps/telemetry/stack:stack_lib",
        "//apps/telemetry/stack/ingest:db_init_scripts",
        "//apps/telemetry/stack/kafka:kafka_configs",
    ],
    visibility = ["//visibility:public"],
)

# ============================================================================
# Test Targets
# ============================================================================

# Unit tests only (no Docker required)
test_suite(
    name = "unit_tests",
    tests = [
        "//apps/telemetry/analysis/tests:analysis_tests",
        "//apps/telemetry/stack/tests:protobuf_test",
    ],
    visibility = ["//visibility:public"],
)

# Integration tests (requires Docker containers to be running)
test_suite(
    name = "integration_tests",
    tags = ["manual", "integration"],
    tests = [
        "//apps/telemetry/stack/tests:bevo_db_integration_test",
        "//apps/telemetry/stack/tests:data_flow_test",
        "//apps/telemetry/stack/tests:db_connectivity_test",
        "//apps/telemetry/stack/tests:kafka_bridge_seed_test",
        "//apps/telemetry/stack/tests:kafka_connectivity_test",
        "//apps/telemetry/stack/tests:mqtt_connectivity_test",
    ],
    visibility = ["//visibility:public"],
)

# Full integration test with Docker lifecycle management
test_suite(
    name = "full_integration_tests",
    tags = ["integration", "docker", "manual"],
    tests = [
        "//apps/telemetry/stack/tests:stack_integration_test",
    ],
    visibility = ["//visibility:public"],
)

# All telemetry tests (unit + integration)
test_suite(
    name = "telemetry_tests",
    tags = ["manual"],  # aggregates the integration suite; presubmit runs :unit_tests via //...
    tests = [
        ":integration_tests",
        ":unit_tests",
    ],
    visibility = ["//visibility:public"],
)

# ============================================================================
# Docker Compose File References
# ============================================================================

# Filegroup containing all docker-compose files for the telemetry stack
filegroup(
    name = "compose_files",
    srcs = [
        "//apps/telemetry/stack/ingest:docker-compose.yml",
        "//apps/telemetry/stack/kafka:docker-compose.yml",
        "//apps/telemetry/stack/processors/gps_classifier:docker-compose.yml",
        "//apps/telemetry/stack/processors/kafka_base:docker-compose.yml",
        "//apps/telemetry/stack/processors/lap_timer:docker-compose.yml",
    ],
    visibility = ["//visibility:public"],
)

# ============================================================================
# Python Library Targets
# ============================================================================

# Complete telemetry Python library (all modules)
py_library(
    name = "telemetry_lib",
    imports = [".", ".."],
    visibility = ["//visibility:public"],
    deps = [
        ":telemetry_common",
        "//apps/telemetry/analysis:analysis_lib",
        "//apps/telemetry/stack:stack_lib",
    ],
    target_compatible_with = ["@platforms//os:linux"],
)
