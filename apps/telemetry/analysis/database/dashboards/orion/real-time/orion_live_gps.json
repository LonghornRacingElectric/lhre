    {
      "type": "xychart",
      "pluginVersion": "11.3.0",
      "title": "G-G, last 20 s",
      "description": "Lateral vs longitudinal g from the chudpi IMU, every message (~15-20 Hz) for the last 20 s, coloured by GPS speed (mph). imu_lat_g/imu_long_g come from the field enricher, rotated onto the car's axes with the mount fitted on 2026-10-10. The enricher's long_g/lat_g are raw sensor axes, not these. Junk samples arrive as null and are dropped. Dotted ring = 1 g (gg_ring_lat/long from the enricher, sweeping once every 4 s). A drag-zoom resets at the next message (Grafana's XY chart rescales on new data); zoom the retrospective G-G instead.",
      "datasource": {
        "type": "lhre-kafka-datasource",
        "uid": "real-time-data"
      },
      "targets": [
        {
          "datasource": {
            "type": "lhre-kafka-datasource",
            "uid": "real-time-data"
          },
          "refId": "A",
          "topicName": "grafana_data_orion_derived",
          "partition": "all",
          "autoOffsetReset": "latest",
          "timestampMode": "message",
          "messageFormat": "json",
          "avroSchemaSource": "schemaRegistry",
          "selectedFields": [
            "imu_lat_g",
            "imu_long_g",
            "gps_speed_kn",
            "gg_ring_lat",
            "gg_ring_long"
          ],
          "sampleIntervalMs": 0,
          "bufferDurationSec": 20
        }
      ],
      "transformations": [
        {
          "id": "filterByValue",
          "options": {
            "type": "exclude",
            "match": "any",
            "filters": [
              {
                "fieldName": "imu_lat_g",
                "config": {
                  "id": "isNull",
                  "options": {}
                }
              },
              {
                "fieldName": "imu_long_g",
                "config": {
                  "id": "isNull",
                  "options": {}
                }
              }
