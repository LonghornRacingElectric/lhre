  "panels": [
    {
      "type": "geomap",
      "title": "Track, last 5 min",
      "description": "Route from latitude/longitude on grafana_data_orion_derived, 50 Hz (sampleIntervalMs 20), coloured by GPS speed (mph). Messages with no fix or a (0,0) fix are dropped. cand keeps the last fix through a GPS dropout, so a stall in the track can mean lost fix, not a stopped car. The view is fixed on the 30.39, -97.73 lot so a zoom or pan holds while data streams; at another site, pan there.",
      "datasource": {
        "type": "lhre-kafka-datasource",
        "uid": "real-time-data"
      },
      "targets": [
        {
          "datasource": {
            "type": "lhre-kafka-datasource",
            "uid": "real-time-data"
          },
          "refId": "A",
          "topicName": "grafana_data_orion_derived",
          "partition": "all",
          "autoOffsetReset": "latest",
          "timestampMode": "message",
          "messageFormat": "json",
          "avroSchemaSource": "schemaRegistry",
          "selectedFields": [
            "lat_precise",
            "lon_precise",
            "gps_speed_kn",
            "gps_sigma_h_m",
            "gps_src"
          ],
          "sampleIntervalMs": 20,
          "bufferDurationSec": 300
        }
      ],
      "transformations": [
        {
          "id": "filterByValue",
          "options": {
            "type": "exclude",
            "match": "any",
            "filters": [
              {
                "fieldName": "lat_precise",
                "config": {
                  "id": "equal",
                  "options": {
                    "value": 0
                  }
                }
              },
              {
                "fieldName": "lon_precise",
                "config": {
                  "id": "equal",
                  "options": {
                    "value": 0
                  }
                }
              },
              {
                "fieldName": "lat_precise",
                "config": {
                  "id": "isNull",
                  "options": {}
                }
              },
              {
                "fieldName": "lon_precise",
                "config": {
                  "id": "isNull",
                  "options": {}
                }
              }
            ]
          }
        },
        {
          "id": "calculateField",
          "options": {
            "mode": "binary",
            "alias": "speed_mph",
            "replaceFields": false,
            "binary": {
              "left": "gps_speed_kn",
              "operator": "*",
              "right": "1.15078"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "velocitymph",
          "decimals": 1,
          "color": {
            "mode": "continuous-YlRd"
          },
          "custom": {
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "lat_precise"
            },
            "properties": [
              {
                "id": "unit",
                "value": "none"
              },
              {
                "id": "decimals",
                "value": 7
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "lon_precise"
            },
            "properties": [
              {
                "id": "unit",
                "value": "none"
              },
              {
                "id": "decimals",
                "value": 7
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "gps_sigma_h_m"
            },
            "properties": [
              {
                "id": "displayName",
