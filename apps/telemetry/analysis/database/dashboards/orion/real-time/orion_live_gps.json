            "binary": {
              "left": "gps_speed_kn",
              "operator": "*",
              "right": "1.15078"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: g",
          "decimals": 2,
          "color": {
            "mode": "fixed",
            "fixedColor": "yellow"
