      "targets": [
        {
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  to_timestamp(\n    floor(packet.time::double precision / $__interval_ms) * $__interval_ms / 1000.0\n  ) AS time,\n  AVG(thermal.module_a_temp)         AS \"inv/module_a_temp [C]\",\n  AVG(thermal.module_b_temp)         AS \"inv/module_b_temp [C]\",\n  AVG(thermal.module_c_temp)         AS \"inv/module_c_temp [C]\",\n  AVG(thermal.gate_driver_temp)      AS \"inv/gate_driver_temp [C]\",\n  AVG(thermal.coolant_temp)          AS \"inv/coolant_temp [C]\",\n  AVG(thermal.inverter_hotspot_temp) AS \"inv/inverter_hotspot_temp [C]\",\n  AVG(thermal.motor_temp)            AS \"inv/motor_temp [C]\"\nFROM thermal\nJOIN packet ON packet.packet_id = thermal.packet_id\nWHERE packet.time BETWEEN $__from AND $__to\nGROUP BY 1\nORDER BY 1;",
          "refId": "A",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
            "groupBy": [
              {
                "property": {
                  "type": "string"
                },
                "type": "groupBy"
              }
            ],
            "limit": 50
          }
        }
      ],
      "title": "Inverter Temperatures [C]",
