      "pluginVersion": "11.3.0",
      "targets": [
        {
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH bounds AS (\r\n  SELECT\r\n    p.start_time AS effective_start,\r\n    p.end_time AS effective_end\r\n  FROM partitions p\r\n  WHERE (\r\n    COALESCE(\r\n      array_length(ARRAY[${Zoom:singlequote}]::text[], 1),\r\n      0\r\n    ) = 0\r\n    OR p.partition_name = ANY(\r\n      ARRAY[${Zoom:singlequote}]::text[]\r\n    )\r\n  )\r\n),\r\ngranularity AS (\r\n  SELECT GREATEST(\r\n    $__interval_ms::double precision, 1\r\n  ) AS step_ms\r\n)\r\nSELECT\r\n  to_timestamp(\r\n    floor(packet.time / granularity.step_ms)\r\n    * granularity.step_ms / 1000.0\r\n  ) AS time,\r\n  AVG(pack.phase_a_current) AS \"inv/phase_a_current [A]\",\r\n  AVG(pack.phase_b_current) AS \"inv/phase_b_current [A]\",\r\n  AVG(pack.phase_c_current) AS \"inv/phase_c_current [A]\",\r\n  AVG(pack.dc_bus_current) AS \"inv/dc_bus_current [A]\",\r\n  AVG(pack.dc_bus_v) AS \"inv/dc_bus_v [V]\",\r\n  AVG(pack.neutral_output_v) AS \"inv/neutral_output_v [V]\",\r\n  AVG(pack.vab_vq_v) AS \"inv/vab_vq_v [V]\",\r\n  AVG(pack.vbc_vd_v) AS \"inv/vbc_vd_v [V]\",\r\n  AVG(pack.bus_voltage) AS \"inv/bus_voltage [V]\"\r\nFROM packet\r\nJOIN pack ON pack.packet_id = packet.packet_id\r\nCROSS JOIN granularity\r\nWHERE packet.time BETWEEN $__from AND $__to\r\n  AND EXISTS (\r\n    SELECT 1\r\n    FROM bounds b\r\n    WHERE packet.time BETWEEN\r\n      b.effective_start AND b.effective_end\r\n  )\r\nGROUP BY 1\r\nORDER BY 1;",
          "refId": "A",
          "sql": {
