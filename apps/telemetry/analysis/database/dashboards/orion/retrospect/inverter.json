          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH bounds AS (\n  SELECT p.start_time AS effective_start, p.end_time AS effective_end\n  FROM partitions p\n  WHERE (COALESCE(array_length(ARRAY[${Zoom:singlequote}]::text[],1),0) = 0\n         OR p.partition_name = ANY(ARRAY[${Zoom:singlequote}]::text[]))\n),\ngranularity AS (\n  SELECT GREATEST($__interval_ms::double precision, 1) AS step_ms\n)\nSELECT\n  to_timestamp(floor(packet.time / granularity.step_ms) * granularity.step_ms / 1000.0) AS time,\n  MAX(d.run_faults)                                  AS \"inv/run_faults\",\n  MAX(d.post_faults)                                 AS \"inv/post_faults\",\n  MAX((d.run_faults::bigint <> 0)::int)              AS \"inv/run_fault_active\",\n  MAX(((d.run_faults::bigint & 524288) <> 0)::int)   AS \"inv/module_b_overtemp (0x80000)\",\n  MAX(d.hvc_state_machine)                           AS \"vcu/hvc_state\"\nFROM packet\nJOIN bounds ON true\nJOIN granularity ON true\nJOIN diagnostics_high d ON d.packet_id = packet.packet_id\nWHERE packet.time BETWEEN bounds.effective_start AND bounds.effective_end\n  AND packet.time BETWEEN $__from AND $__to\nGROUP BY 1\nORDER BY 1;",
          "refId": "A",
