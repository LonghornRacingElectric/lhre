      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "orion"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH bounds AS (\n  SELECT GREATEST(p.start_time, $__from) AS t0, LEAST(p.end_time, $__to) AS t1\n  FROM partitions p\n  WHERE (COALESCE(array_length(ARRAY[${Zoom:singlequote}]::text[], 1), 0) = 0\n         OR p.partition_name = ANY(ARRAY[${Zoom:singlequote}]::text[]))\n    AND p.end_time >= $__from AND p.start_time <= $__to\n)\nSELECT MAX(dynamics.gps_speed * 1.15078) FILTER (WHERE cardinality(dynamics.gps) = 2 AND dynamics.gps[1] <> 0 AND dynamics.gps[2] <> 0\n  AND dynamics.gps[1] BETWEEN -90 AND 90 AND dynamics.gps[2] BETWEEN -180 AND 180) AS \"top_mph\",\n  100.0 * COUNT(*) FILTER (WHERE cardinality(dynamics.gps) = 2 AND dynamics.gps[1] <> 0 AND dynamics.gps[2] <> 0\n  AND dynamics.gps[1] BETWEEN -90 AND 90 AND dynamics.gps[2] BETWEEN -180 AND 180) / NULLIF(COUNT(*), 0) AS \"fix_pct\",\n  AVG(0.8907 * dynamics.gps_imu[1] + 0.3899 * dynamics.gps_imu[2] - 0.2338 * dynamics.gps_imu[3]) FILTER (WHERE cardinality(dynamics.gps_imu) = 3 AND abs(dynamics.gps_imu[1]) < 50 AND abs(dynamics.gps_imu[2]) < 50 AND abs(dynamics.gps_imu[3]) < 50\n  AND (dynamics.gps_imu[1] <> 0 OR dynamics.gps_imu[2] <> 0 OR dynamics.gps_imu[3] <> 0)) / 9.81 AS \"vert_g\",\n  percentile_cont(0.5) WITHIN GROUP (ORDER BY dynamics.gps_precise[4]) FILTER (WHERE cardinality(dynamics.gps_precise) = 6 AND dynamics.gps_precise[1] <> 0 AND dynamics.gps_precise[2] <> 0) AS \"sigma_median_m\",\n  100.0 * COUNT(*) FILTER (WHERE cardinality(dynamics.gps_precise) = 6 AND dynamics.gps_precise[1] <> 0 AND dynamics.gps_precise[2] <> 0 AND dynamics.gps_precise[5] = 2) / NULLIF(COUNT(*) FILTER (WHERE cardinality(dynamics.gps_precise) = 6 AND dynamics.gps_precise[1] <> 0 AND dynamics.gps_precise[2] <> 0), 0) AS \"rtk_pct\"\nFROM packet JOIN dynamics USING (packet_id)\nWHERE packet.time BETWEEN $__from AND $__to\n  AND EXISTS (SELECT 1 FROM bounds b WHERE packet.time BETWEEN b.t0 AND b.t1)",
          "refId": "A"
        }
      ],
      "title": "Top GPS speed",
