      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "orion"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH bounds AS (\n  SELECT GREATEST(p.start_time, $__from) AS t0, LEAST(p.end_time, $__to) AS t1\n  FROM partitions p\n  WHERE (COALESCE(array_length(ARRAY[${Zoom:singlequote}]::text[], 1), 0) = 0\n         OR p.partition_name = ANY(ARRAY[${Zoom:singlequote}]::text[]))\n    AND p.end_time >= $__from AND p.start_time <= $__to\n),\nw AS (SELECT GREATEST((MAX(t1) - MIN(t0)) / 5000, 50) AS ms FROM bounds)\nSELECT DISTINCT ON (packet.time / w.ms) to_timestamp(packet.time / 1000.0) AS time,\n  CASE WHEN cardinality(dynamics.gps_precise) = 6 AND dynamics.gps_precise[1] <> 0 AND dynamics.gps_precise[2] <> 0 THEN dynamics.gps_precise[1] ELSE dynamics.gps[1] END AS \"lat\",\n  CASE WHEN cardinality(dynamics.gps_precise) = 6 AND dynamics.gps_precise[1] <> 0 AND dynamics.gps_precise[2] <> 0 THEN dynamics.gps_precise[2] ELSE dynamics.gps[2] END AS \"lon\",\n  dynamics.gps_speed * 1.15078 AS \"speed_mph\",\n  CASE WHEN cardinality(dynamics.gps_precise) = 6 AND dynamics.gps_precise[1] <> 0 AND dynamics.gps_precise[2] <> 0 THEN dynamics.gps_precise[4] END AS \"sigma_m\",\n  CASE WHEN cardinality(dynamics.gps_precise) = 6 AND dynamics.gps_precise[1] <> 0 AND dynamics.gps_precise[2] <> 0 THEN dynamics.gps_precise[5] END AS \"src\"\nFROM packet JOIN dynamics USING (packet_id), w\nWHERE packet.time BETWEEN $__from AND $__to\n  AND EXISTS (SELECT 1 FROM bounds b WHERE packet.time BETWEEN b.t0 AND b.t1)\n  AND cardinality(dynamics.gps) = 2 AND dynamics.gps[1] <> 0 AND dynamics.gps[2] <> 0\n  AND dynamics.gps[1] BETWEEN -90 AND 90 AND dynamics.gps[2] BETWEEN -180 AND 180\nORDER BY packet.time / w.ms, packet.time",
          "refId": "A"
        }
      ],
      "title": "Track",
      "transformations": [],
      "type": "geomap"
    },
    {
      "datasource": {
