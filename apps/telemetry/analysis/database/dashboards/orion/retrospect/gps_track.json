      "pluginVersion": "11.3.0",
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "orion"
          },
          "editorMode": "code",
          "format": "table",
          "maxDataPoints": 5000,
          "rawQuery": true,
          "rawSql": "WITH bounds AS (\n  SELECT GREATEST(p.start_time, $__from) AS t0, LEAST(p.end_time, $__to) AS t1\n  FROM partitions p\n  WHERE (COALESCE(array_length(ARRAY[${Zoom:singlequote}]::text[], 1), 0) = 0\n         OR p.partition_name = ANY(ARRAY[${Zoom:singlequote}]::text[]))\n    AND p.end_time >= $__from AND p.start_time <= $__to\n),\nw AS (SELECT GREATEST((MAX(t1) - MIN(t0)) / 5000, 100) AS ms FROM bounds)\nSELECT DISTINCT ON (packet.time / w.ms) to_timestamp(packet.time / 1000.0) AS time,\n  (-0.2835 * dynamics.gps_imu[1] + 0.0741 * dynamics.gps_imu[2] - 0.9561 * dynamics.gps_imu[3]) / 9.81 AS \"lat_g\",\n  (-0.3555 * dynamics.gps_imu[1] + 0.9178 * dynamics.gps_imu[2] + 0.1766 * dynamics.gps_imu[3]) / 9.81 AS \"long_g\",\n  dynamics.gps_speed * 1.15078 AS \"speed_mph\"\nFROM packet JOIN dynamics USING (packet_id), w\nWHERE packet.time BETWEEN $__from AND $__to\n  AND EXISTS (SELECT 1 FROM bounds b WHERE packet.time BETWEEN b.t0 AND b.t1)\n  AND cardinality(dynamics.gps_imu) = 3 AND abs(dynamics.gps_imu[1]) < 50 AND abs(dynamics.gps_imu[2]) < 50 AND abs(dynamics.gps_imu[3]) < 50\n  AND (dynamics.gps_imu[1] <> 0 OR dynamics.gps_imu[2] <> 0 OR dynamics.gps_imu[3] <> 0)\nORDER BY packet.time / w.ms, packet.time",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "orion"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT sin(radians(a)) AS \"ring_lat\", cos(radians(a)) AS \"ring_long\"\nFROM generate_series(0, 360, 5) AS a",
          "refId": "B"
        }
      ],
      "title": "G-G",
      "transformations": [],
      "type": "xychart"
    },
