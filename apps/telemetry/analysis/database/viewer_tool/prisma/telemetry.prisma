generator client {
  provider = "prisma-client-js"
  output   = "../.prisma/telemetry-client"
}

datasource db {
  provider = "postgresql"
  url      = env("TELEMETRY_DATABASE_URL")
}

// ----------------------------------------------------
// DRIVE DAY TABLE
// ----------------------------------------------------
model drive_day {
  day_id            Int      @id @default(autoincrement())
  date              DateTime
  track_name        String?
  weather           String?
  wind_speed        Float?
  power_limit       Int?
  air_temperature   Float?
  relative_humidity Float?
  track_temperature Float?
  // Status and timing
  status            Int?
  creation_time     BigInt?
  start_time        BigInt?
  end_time          BigInt?
  packet_start      BigInt?
  packet_end        BigInt?
  // Driver, car, location, event type
  car_id            Int?
  driver_id         Int?
  location_id       Int?
  event_type        Int?
  // Car setup
  car_weight          Int?
  tow_angle           Float?
  camber_front        Float?
  camber_rear         Float?
  toe_front           Float?
  toe_rear            Float?
  ride_height_front   Float?
  ride_height_rear    Float?
  ride_height         Float?
  ackerman_adjustment Float?
  shock_dampening     Int?
  torque_limit        Int?
  // Tire cold pressures
  frw_pressure        Float?
  flw_pressure        Float?
  brw_pressure        Float?
  blw_pressure        Float?
  // Tire hot pressures
  frw_hot_pressure    Float?
  flw_hot_pressure    Float?
  brw_hot_pressure    Float?
  blw_hot_pressure    Float?
  // Tire wear depth and durometer
  fr_wear_depth       Float?
  fl_wear_depth       Float?
  rr_wear_depth       Float?
  rl_wear_depth       Float?
  fr_durometer        Float?
  fl_durometer        Float?
  rr_durometer        Float?
  rl_durometer        Float?
  // Shock damping per corner (LSC/LSR/HSC/HSR)
  fr_lsc              Int?
  fr_lsr              Int?
  fr_hsc              Int?
  fr_hsr              Int?
  fl_lsc              Int?
  fl_lsr              Int?
  fl_hsc              Int?
  fl_hsr              Int?
  rr_lsc              Int?
  rr_lsr              Int?
  rr_hsc              Int?
  rr_hsr              Int?
  rl_lsc              Int?
  rl_lsr              Int?
  rl_hsc              Int?
  rl_hsr              Int?
  // Aero
  front_wing_on            Boolean?
  rear_wing_on             Boolean?
  front_wing_pitch         Float?
  rear_wing_pitch          Float?
  regen_on                 Boolean?
  undertray_on             Boolean?
  // Specialty springs
  front_roll_spring_rate   Float?
  front_heave_spring_rate  Float?
  rear_roll_spring_rate    Float?
  rear_heave_spring_rate   Float?
  front_corner_spring_rate Float?
  rear_corner_spring_rate  Float?
  front_arb_setting        String?
  rear_arb_setting         String?

  // Relations
  car        lut_car?        @relation(fields: [car_id],      references: [car_id])
  driver     lut_driver?     @relation(fields: [driver_id],   references: [driver_id])
  location   lut_location?   @relation(fields: [location_id], references: [location_id])
  eventType  lut_event_type? @relation(fields: [event_type],  references: [type_id])

  @@index([car_id])
  @@index([driver_id])
  @@index([location_id])
  @@index([event_type])
}

// ----------------------------------------------------
// LOOKUP TABLES
// ----------------------------------------------------
model lut_driver {
  driver_id     Int     @id
  driver_name   String
  driver_weight Int?

  drive_days    drive_day[]
}

model lut_location {
  location_id Int    @id
  area        String
  track       String

  drive_days  drive_day[]
}

model lut_car {
  car_id   Int    @id
  car_name String

  drive_days drive_day[]
}

model lut_event_type {
  type_id    Int    @id
  event_type String

  drive_days drive_day[]
}

// Car measurements use the separate generated Orion and Artemis clients.
model track_mapping {
  track_mapping_id  Int      @id @default(autoincrement())
  name              String
  created_at        BigInt
  start_gate_lat1   Float
  start_gate_lon1   Float
  start_gate_lat2   Float
  start_gate_lon2   Float
  points            Json?
  sectors           Json?
}

// ----------------------------------------------------
// CLASSIFIER TABLE
// ----------------------------------------------------
model classifier {
  day_id     BigInt
  type       String
  start_time BigInt
  end_time   BigInt?
  notes      String?

  @@id([day_id, type, start_time])
}
