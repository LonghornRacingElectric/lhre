# telemetry/analysis/BUILD.bazel

load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")
load("@telemetry_stack_reqs//:requirements.bzl", "requirement")
load("@telemetry_reqs//:requirements.bzl", analysis_requirement = "requirement")
load("@rules_python//python:pip.bzl", "compile_pip_requirements")
load("//apps/telemetry:compatibility.bzl", "NOT_WINDOWS")

# This target bundles all python files in the analysis directory
# into a library that can be used by other targets (like tests).
py_library(
    name = "analysis_lib",
    srcs = glob(["**/*.py"]),
    # This allows imports relative to the workspace root
    imports = [".", "..", "../.."],
    target_compatible_with = NOT_WINDOWS,
    visibility = ["//visibility:public"],
    deps = ["//lib/codegen/telemetry:orion_models", "//lib/codegen/telemetry:artemis_models"],
)

# Platform-aware pip requirements compilation
# Uses platform-specific lock files automatically based on the host OS
# requirements_txt serves as the default (Linux) fallback
compile_pip_requirements(
    name = "telemetry_requirements",
    data = ["//apps/telemetry:windows_incompatible"],
    src = "requirements.txt",
    generate_hashes = False,
    python_version = "3.12",
    requirements_darwin = "requirements_lock_darwin.txt",
    requirements_txt = "requirements_lock.txt",
    requirements_windows = "requirements_lock_windows.txt",
    tags = ["manual", "requirements"],
    target_compatible_with = NOT_WINDOWS,
)

py_library(
    name = "query_client",
    srcs = ["query_client.py"],
    imports = [".."],
    deps = [requirement("requests")],
    visibility = ["//apps/telemetry:__subpackages__"],
    target_compatible_with = NOT_WINDOWS,
)

py_library(
    name = "native_demo",
    srcs = ["database/native_demo.py"],
    imports = [".."],
    data = ["//apps/telemetry/stack/ingest:artemis_pb2", "//lib/codegen/telemetry:storage_contract", "//lib/codegen/telemetry:artemis_schema_contract"],
    deps = [requirement("paho-mqtt"), requirement("protobuf"), "@lhre_pypi//bazel_runfiles"],
    visibility = ["//apps/telemetry:__subpackages__"],
    target_compatible_with = NOT_WINDOWS,
)

py_binary(
    name = "publish_demo",
    srcs = ["database/paho_testing.py"],
    main = "database/paho_testing.py",
    deps = [":paho_testing"],
    target_compatible_with = NOT_WINDOWS,
)

py_library(
    name = "paho_testing",
    srcs = ["database/paho_testing.py"],
    imports = [".."],
    deps = [":native_demo", requirement("numpy"), requirement("pandas"), requirement("requests"), analysis_requirement("tqdm")],
    visibility = ["//apps/telemetry:__subpackages__"],
    target_compatible_with = NOT_WINDOWS,
)

py_test(
    name = "paho_testing_test",
    srcs = ["database/paho_testing_test.py"],
    deps = [":paho_testing", "//apps/telemetry/stack/ingest:sensor_decode"],
    target_compatible_with = NOT_WINDOWS,
)

py_binary(
    name = "validate_live_viewer",
    visibility = ["//apps/telemetry:__subpackages__"],
    srcs = ["database/validate_live_viewer.py"],
    main = "database/validate_live_viewer.py",
    deps = [":query_client", ":native_demo"],
    target_compatible_with = NOT_WINDOWS,
)

py_test(
    name = "query_client_test",
    srcs = ["query_client_test.py"],
    deps = [":query_client"],
    target_compatible_with = NOT_WINDOWS,
)
