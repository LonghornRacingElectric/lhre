load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_test")

package(default_visibility = ["//apps/BEVO:__subpackages__"])

NOT_WINDOWS = select({
    "@platforms//os:windows": ["@platforms//:incompatible"],
    "//conditions:default": [],
})

rust_binary(
    name = "loggerd",
    srcs = ["main.rs"],
    edition = "2021",
    target_compatible_with = NOT_WINDOWS,
    deps = [
        "//apps/BEVO:sensor_proto",
        "@crates//:anyhow",
        "@crates//:prost",
        "@crates//:serde_json",
    ],
)

rust_test(
    name = "loggerd_test",
    crate = ":loggerd",
    target_compatible_with = NOT_WINDOWS,
)
