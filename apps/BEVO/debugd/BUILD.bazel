load("@rules_rust//rust:defs.bzl", "rust_binary")

package(default_visibility = ["//apps/BEVO:__subpackages__"])

rust_binary(
    name = "debugd",
    srcs = ["main.rs"],
    edition = "2021",
    # Unix-socket IPC — no Windows.
    target_compatible_with = select({
        "@platforms//os:windows": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    deps = [
        "//apps/BEVO:sensor_proto",
        "@crates//:anyhow",
        "@crates//:prost",
    ],
)
