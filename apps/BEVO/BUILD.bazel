load("@aspect_bazel_lib//lib:transitions.bzl", "platform_transition_filegroup")
load("@rules_python//python:defs.bzl", "py_binary", "py_test")
load("@rules_rust//cargo:defs.bzl", "cargo_build_script")
load("@rules_rust//rust:defs.bzl", "rust_library")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("@rules_oci//oci:defs.bzl", "oci_image", "oci_push")

package(default_visibility = ["//apps/BEVO:__subpackages__"])

# rules_rust on Windows wants the MSVC target triple while our hermetic clang
# targets MinGW, so nothing Rust-shaped builds there: the Windows presubmit
# skips these targets and everything that depends on them. Build BEVO on
# Linux or macOS, or let the Linux CI job do it.
NOT_WINDOWS = select({
    "@platforms//os:windows": ["@platforms//:incompatible"],
    "//conditions:default": [],
})

exports_files([
    "Cargo.toml",
    "Cargo.lock",
])

alias(
    name = "can_json",
    actual = "//lib/codegen/telemetry:can_json",
)

# Runs build.rs to generate the prost bindings AND generated_mapping.rs into
# OUT_DIR (lib.rs include!()s both) from the hermetic protoc and the shared
# Bazel-generated protobuf and CAN JSON.
cargo_build_script(
    name = "sensor_proto_build",
    srcs = ["build.rs"],
    build_script_env = {
        "CAN_JSON": "$(execpath //lib/codegen/telemetry:can_json)",
        "PROTO_FILE": "$(execpath //lib/codegen/telemetry:can_packets_proto)",
        "PROTOC": "$(execpath //tools/protoc)",
        "SCHEMA_CONTRACT": "$(execpath //lib/codegen/telemetry:schema_contract)",
    },
    data = [
        "//lib/codegen/telemetry:can_json",
        "//lib/codegen/telemetry:can_packets_proto",
        "//lib/codegen/telemetry:schema_contract",
    ],
    edition = "2021",
    target_compatible_with = NOT_WINDOWS,
    tools = ["//tools/protoc"],
    deps = [
        "@crates//:prost",
        "@crates//:prost-build",
        "@crates//:prost-types",
        "@crates//:serde_json",
    ],
)

rust_library(
    name = "sensor_proto",
    srcs = [
        "config.rs",
        "lib.rs",
    ],
    edition = "2021",
    target_compatible_with = NOT_WINDOWS,
    deps = [
        ":sensor_proto_build",
        "@crates//:prost",
        "@crates//:serde",
    ],
)

# ---- Pi deployment ---------------------------------------------------------
# The repo is too big to clone onto the Pi, so deploys ship binaries instead:
# the daemons cross-compile to static aarch64-musl ELFs (//platforms:pi),
# get bundled with the runbook scripts, and one command
# pushes the bundle over SSH. See README.md → "Deploying to the Pi".

_PI_CORE_DAEMONS = [
    "//apps/BEVO/cand",
    "//apps/BEVO/loggerd",
    "//apps/BEVO/publishd",
]

platform_transition_filegroup(
    name = "pi_core_binaries",
    srcs = _PI_CORE_DAEMONS,
    target_compatible_with = NOT_WINDOWS,
    target_platform = "//platforms:pi",
    visibility = ["//visibility:public"],
)

py_test(
    name = "pi_core_binary_test",
    size = "small",
    srcs = ["pi_core_binary_test.py"],
    args = ["$(rootpaths :pi_core_binaries)"],
    data = [":pi_core_binaries"],
    target_compatible_with = NOT_WINDOWS,
)

py_binary(
    name = "release_metadata",
    srcs = ["release_metadata.py"],
    deps = ["//lib/telemetry:contract"],
)

genrule(
    name = "pi_core_manifest",
    srcs = [
        ":pi_core_binaries",
        "//lib/codegen/telemetry:can_json",
        "//lib/codegen/telemetry:schema_contract",
        "//lib/codegen/telemetry:schema_descriptor",
    ],
    outs = ["pi_core_manifest.json"],
    cmd = "$(execpath :release_metadata) --out $@ --can-json $(location //lib/codegen/telemetry:can_json) --contract $(location //lib/codegen/telemetry:schema_contract) --descriptor $(location //lib/codegen/telemetry:schema_descriptor) $(locations :pi_core_binaries)",
    tools = [":release_metadata"],
    target_compatible_with = NOT_WINDOWS,
    visibility = ["//visibility:public"],
)

py_test(
    name = "release_metadata_test",
    srcs = ["release_metadata.py", "release_metadata_test.py"],
    main = "release_metadata_test.py",
    deps = ["//lib/telemetry:contract"],
    args = [
        "$(rootpath :pi_core_manifest)",
        "$(rootpath //lib/codegen/telemetry:can_json)",
        "$(rootpath //lib/codegen/telemetry:schema_contract)",
        "$(rootpath //lib/codegen/telemetry:schema_descriptor)",
        "$(rootpaths :pi_core_binaries)",
    ],
    data = [
        ":pi_core_manifest", ":pi_core_binaries",
        "//lib/codegen/telemetry:can_json",
        "//lib/codegen/telemetry:schema_contract",
        "//lib/codegen/telemetry:schema_descriptor",
    ],
    target_compatible_with = NOT_WINDOWS,
)

genrule(
    name = "pi_core_layers",
    srcs = [
        ":pi_core_manifest", ":pi_core_binaries",
        "//lib/codegen/telemetry:can_json",
        "//lib/codegen/telemetry:schema_contract",
        "//lib/codegen/telemetry:schema_descriptor",
    ],
    outs = ["pi_core_metadata.tar.gz", "pi_core_executables.tar.gz"],
    tools = ["//apps/BEVO/updater:package"],
    cmd = "$(execpath //apps/BEVO/updater:package) layers --manifest $(location :pi_core_manifest) --contract $(location //lib/codegen/telemetry:schema_contract) --descriptor $(location //lib/codegen/telemetry:schema_descriptor) --can-json $(location //lib/codegen/telemetry:can_json) --metadata-out $(location pi_core_metadata.tar.gz) --binaries-out $(location pi_core_executables.tar.gz) $(locations :pi_core_binaries)",
    target_compatible_with = NOT_WINDOWS,
)

filegroup(
    name = "pi_core_metadata_layer",
    srcs = ["pi_core_metadata.tar.gz"],
    visibility = ["//visibility:public"],
    target_compatible_with = NOT_WINDOWS,
)

filegroup(
    name = "pi_core_executables_layer",
    srcs = ["pi_core_executables.tar.gz"],
    visibility = ["//visibility:public"],
    target_compatible_with = NOT_WINDOWS,
)

oci_image(
    name = "pi_core_image",
    os = "linux",
    architecture = "arm64",
    tars = [":pi_core_metadata_layer", ":pi_core_executables_layer"],
    annotations = {"org.opencontainers.image.source": "https://github.com/LonghornRacingElectric/lhre"},
    visibility = ["//visibility:public"],
    target_compatible_with = NOT_WINDOWS,
)

oci_push(
    name = "pi_core_push",
    image = ":pi_core_image",
    repository = "ghcr.io/longhornracingelectric/bevo-core",
    target_compatible_with = NOT_WINDOWS,
)

platform_transition_filegroup(
    name = "pi_binaries",
    srcs = _PI_CORE_DAEMONS + [
        "//apps/BEVO/dashd",
        "//apps/BEVO/debugd",
    ],
    target_compatible_with = NOT_WINDOWS,
    target_platform = "//platforms:pi",
)

_BUNDLE_SCRIPTS = [
    "nonhermetic/run_real_stack.sh",
    "nonhermetic/start_telemetry.sh",
]

_BUNDLE_FILES = [
    "cell.py",
    "locus_power.sh",
    "nonhermetic/bevo_telemetry.service",
    "requirements.txt",
]

# genrule needs bash; deploys happen from macOS/Linux machines.
genrule(
    name = "pi_bundle",
    srcs = [":pi_binaries"] + _BUNDLE_SCRIPTS + _BUNDLE_FILES,
    outs = ["pi_bundle.tar.gz"],
    cmd = """
        STAGE=$$(mktemp -d)
        mkdir -p $$STAGE/bin $$STAGE/nonhermetic
        for b in $(locations :pi_binaries); do cp $$b $$STAGE/bin/; done
        cp $(location nonhermetic/run_real_stack.sh) $(location nonhermetic/start_telemetry.sh) $$STAGE/nonhermetic/
        chmod +x $$STAGE/nonhermetic/*.sh
        cp $(location cell.py) $(location locus_power.sh) $(location requirements.txt) $$STAGE/
        chmod +x $$STAGE/locus_power.sh
        cp $(location nonhermetic/bevo_telemetry.service) $$STAGE/nonhermetic/
        tar czf $@ -C $$STAGE .
        rm -rf $$STAGE
    """,
    target_compatible_with = NOT_WINDOWS,
)

sh_binary(
    name = "deploy",
    srcs = ["deploy_pi.sh"],
    data = [":pi_bundle"],
    target_compatible_with = NOT_WINDOWS,
)
