load("@aspect_bazel_lib//lib:transitions.bzl", "platform_transition_filegroup")
load("@rules_rust//cargo:defs.bzl", "cargo_build_script")
load("@rules_rust//rust:defs.bzl", "rust_library")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")

package(default_visibility = ["//apps/BEVO:__subpackages__"])

# rules_rust on Windows wants the MSVC target triple while our hermetic clang
# targets MinGW, so nothing Rust-shaped builds there: the Windows presubmit
# skips these targets and everything that depends on them. Build BEVO on
# Linux or macOS, or let the Linux CI job do it.
NOT_WINDOWS = select({
    "@platforms//os:windows": ["@platforms//:incompatible"],
    "//conditions:default": [],
})

exports_files([
    "Cargo.toml",
    "Cargo.lock",
])

# The runtime CAN decode map, generated by Bazel from the CSV source of
# truth in schema/. Daemons read it at runtime, so it rides along as a data
# dep (runfiles path: apps/BEVO/schema/can.json).
alias(
    name = "can_json",
    actual = "//apps/BEVO/schema:can_json",
)

# Runs build.rs to generate the prost bindings AND generated_mapping.rs into
# OUT_DIR (lib.rs include!()s both) — same script the Cargo flow runs, but
# pointed at the hermetic protoc and the Bazel-generated can.json.
cargo_build_script(
    name = "sensor_proto_build",
    srcs = ["build.rs"],
    build_script_env = {
        "CAN_JSON": "$(execpath //apps/BEVO/schema:can_json)",
        "PROTO_FILE": "$(execpath //apps/BEVO/schema:can_packets.proto)",
        "PROTOC": "$(execpath //tools/protoc)",
    },
    data = [
        "//apps/BEVO/schema:can_json",
        "//apps/BEVO/schema:can_packets.proto",
    ],
    edition = "2021",
    target_compatible_with = NOT_WINDOWS,
    tools = ["//tools/protoc"],
    deps = [
        "@crates//:prost",
        "@crates//:prost-build",
        "@crates//:prost-types",
        "@crates//:serde_json",
    ],
)

rust_library(
    name = "sensor_proto",
    srcs = [
        "config.rs",
        "lib.rs",
    ],
    edition = "2021",
    target_compatible_with = NOT_WINDOWS,
    deps = [
        ":sensor_proto_build",
        "@crates//:prost",
        "@crates//:serde",
    ],
)

# ---- Pi deployment ---------------------------------------------------------
# The repo is too big to clone onto the Pi, so deploys ship binaries instead:
# the daemons cross-compile to static aarch64-musl ELFs (//platforms:pi),
# get bundled with the runtime assets and runbook scripts, and one command
# pushes the bundle over SSH. See README.md → "Deploying to the Pi".

platform_transition_filegroup(
    name = "pi_binaries",
    srcs = [
        "//apps/BEVO/cand",
        "//apps/BEVO/dashd",
        "//apps/BEVO/debugd",
        "//apps/BEVO/loggerd",
        "//apps/BEVO/publishd",
    ],
    target_compatible_with = NOT_WINDOWS,
    target_platform = "//platforms:pi",
)

_BUNDLE_SCRIPTS = [
    "nonhermetic/run_real_stack.sh",
    "nonhermetic/start_telemetry.sh",
]

_BUNDLE_FILES = [
    "cell.py",
    "locus_power.sh",
    "nonhermetic/bevo_telemetry.service",
    "requirements.txt",
    "//apps/BEVO/schema:can_json",
]

# genrule needs bash; deploys happen from macOS/Linux machines.
genrule(
    name = "pi_bundle",
    srcs = [":pi_binaries"] + _BUNDLE_SCRIPTS + _BUNDLE_FILES,
    outs = ["pi_bundle.tar.gz"],
    cmd = """
        STAGE=$$(mktemp -d)
        mkdir -p $$STAGE/bin $$STAGE/nonhermetic/assets
        for b in $(locations :pi_binaries); do cp $$b $$STAGE/bin/; done
        cp $(location nonhermetic/run_real_stack.sh) $(location nonhermetic/start_telemetry.sh) $$STAGE/nonhermetic/
        chmod +x $$STAGE/nonhermetic/*.sh
        cp $(location cell.py) $(location locus_power.sh) $(location requirements.txt) $$STAGE/
        chmod +x $$STAGE/locus_power.sh
        cp $(location nonhermetic/bevo_telemetry.service) $$STAGE/nonhermetic/
        cp $(location //apps/BEVO/schema:can_json) $$STAGE/nonhermetic/assets/can.json
        tar czf $@ -C $$STAGE .
        rm -rf $$STAGE
    """,
    target_compatible_with = NOT_WINDOWS,
)

sh_binary(
    name = "deploy",
    srcs = ["deploy_pi.sh"],
    data = [":pi_bundle"],
    target_compatible_with = NOT_WINDOWS,
)
