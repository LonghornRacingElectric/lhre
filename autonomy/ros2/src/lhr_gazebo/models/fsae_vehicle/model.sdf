<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="fsae_vehicle">
    <!--
      GENERATED FILE: do not edit model.sdf by hand.
      Source: lhr_vehicle/config/vehicle.yaml rendered through
      lhr_gazebo/templates/model.sdf.in by lhr_gazebo/scripts/generate_vehicle_model.py.

      Wheelbase: 1.5494 m   Track: 1.2122 m   Wheel radius: 0.2045 m
      Mass: 160.6 kg chassis + 4x 8.5 kg wheels
      Reference point: rear axle center at ground level.
      Chassis link is 0.7747 m forward (half wheelbase), 0.35 m up.
      Steering joints: ±0.6787 rad = the inner wheel at 0.55 rad center lock.
    -->

    <!-- ===== CHASSIS ===== -->
    <link name="chassis">
      <pose>0.7747 0 0.35 0 0 0</pose>
      <inertial>
        <mass>160.6</mass>
        <!-- solid box of the collision dimensions -->
        <inertia>
          <ixx>14.2198</ixx>
          <iyy>65.6118</iyy>
          <izz>78.1587</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="body_visual">
        <!-- mesh scale/offset were fitted to a 1.6 m wheelbase; scaled with it -->
        <pose>-0.0678 -0.0194 0.0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://fsae_vehicle/meshes/carBody.stl</uri>
            <scale>1.6462 1.6462 1.6462</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.8 0.3 0.0 1</ambient>
          <diffuse>0.8 0.3 0.0 1</diffuse>
        </material>
      </visual>
      <collision name="body_collision">
        <geometry>
          <box><size>2.2 1 0.25</size></box>
        </geometry>
      </collision>

      <!-- IMU sensor, at the chassis link origin -->
      <sensor name="imu_sensor" type="imu">
        <pose>0 0 0 0 0 0</pose>
        <always_on>true</always_on>
        <update_rate>100</update_rate>
        <visualize>false</visualize>
        <topic>/imu/data</topic>
      </sensor>

      <!-- Mid-360 approximation. Gazebo repeats this regular grid rather than
           the real sensor's non-repeating scan pattern. 500 x 40 rays at
           10 Hz give the nominal 200,000 first-return points/s budget. -->
      <sensor name="lidar" type="gpu_lidar">
        <pose>1.0253 0 0.2 0 0 0</pose>
        <always_on>true</always_on>
        <update_rate>10</update_rate>
        <visualize>true</visualize>
        <topic>/lidar/points</topic>
        <lidar>
          <scan>
            <horizontal>
              <samples>500</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159</min_angle>
              <max_angle>3.14159</max_angle>
            </horizontal>
            <vertical>
              <samples>40</samples>
              <resolution>1</resolution>
              <min_angle>-0.122173</min_angle>
              <max_angle>0.907571</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.1</min>
            <max>40.0</max>
            <resolution>0.01</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0</mean>
            <stddev>0.02</stddev>
          </noise>
        </lidar>
      </sensor>
    </link>

    <!-- One ZED 2i rig. Shared parent preserves Harmonic's stereo baseline
         calculation when mount yaw/pitch changes. Inertia is sim bookkeeping. -->
    <link name="zed2i_link">
      <pose relative_to="chassis">1.0253 0 0.3 0 0 0</pose>
      <inertial>
        <mass>0.001</mass>
        <inertia><ixx>0.000001</ixx><iyy>0.000001</iyy><izz>0.000001</izz></inertia>
      </inertial>
      <sensor name="zed2i_left" type="camera">
        <pose>0 0.06 0 0 0 0</pose>
        <always_on>true</always_on>
        <update_rate>30</update_rate>
        <topic>/zed2i/left/image_rect</topic>
        <camera>
          <horizontal_fov>1.91986217719</horizontal_fov>
          <image>
            <width>1280</width><height>720</height>
            <format>R8G8B8</format>
          </image>
          <clip><near>0.1</near><far>100</far></clip>
          <camera_info_topic>/zed2i/left/camera_info</camera_info_topic>
          <optical_frame_id>zed2i_left_camera_optical_frame</optical_frame_id>
          <lens>
            <intrinsics>
              <fx>448.132824454</fx><fy>448.132824454</fy>
              <cx>640</cx><cy>360</cy><s>0</s>
            </intrinsics>
          </lens>
        </camera>
      </sensor>
      <sensor name="zed2i_right" type="camera">
        <pose>0 -0.06 0 0 0 0</pose>
        <always_on>true</always_on>
        <update_rate>30</update_rate>
        <topic>/zed2i/right/image_rect</topic>
        <camera>
          <horizontal_fov>1.91986217719</horizontal_fov>
          <image>
            <width>1280</width><height>720</height>
            <format>R8G8B8</format>
          </image>
          <clip><near>0.1</near><far>100</far></clip>
          <camera_info_topic>/zed2i/right/camera_info</camera_info_topic>
          <optical_frame_id>zed2i_right_camera_optical_frame</optical_frame_id>
          <lens>
            <intrinsics>
              <fx>448.132824454</fx><fy>448.132824454</fy>
              <cx>640</cx><cy>360</cy><s>0</s>
            </intrinsics>
          </lens>
        </camera>
      </sensor>
    </link>
    <joint name="zed2i_mount" type="fixed">
      <parent>chassis</parent><child>zed2i_link</child>
    </joint>

    <!-- ===== FRONT LEFT STEERING KNUCKLE ===== -->
    <link name="front_left_steering">
      <pose>1.5494 0.6061 0.2045 0 0 0</pose>
      <inertial>
        <mass>0.1</mass>
        <inertia>
          <ixx>0.0001</ixx><iyy>0.0001</iyy><izz>0.0001</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
    </link>

    <joint name="front_left_steering_joint" type="revolute">
      <parent>chassis</parent>
      <child>front_left_steering</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-0.6787</lower>
          <upper>0.6787</upper>
          <effort>1e6</effort>
          <velocity>10</velocity>
        </limit>
      </axis>
    </joint>

    <!-- FRONT LEFT WHEEL (links are rolled -90° about x: the spin axis is link-local z) -->
    <link name="front_left_wheel">
      <pose>1.5494 0.6061 0.2045 -1.5708 0 0</pose>
      <inertial>
        <mass>8.5</mass>
        <inertia>
          <ixx>0.1048</ixx><iyy>0.1048</iyy><izz>0.1777</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="visual">
        <pose>-0.6033 -0.2045 -0.6237 1.5708 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://fsae_vehicle/meshes/carTire.stl</uri>
            <scale>2.2188 2.2188 2.2188</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.15 0.15 0.15 1</ambient>
          <diffuse>0.15 0.15 0.15 1</diffuse>
        </material>
      </visual>
      <collision name="collision">
        <geometry>
          <cylinder><radius>0.2045</radius><length>0.15</length></cylinder>
        </geometry>
        <surface>
          <friction>
            <ode><mu>1.0</mu><mu2>0.8</mu2></ode>
          </friction>
        </surface>
      </collision>
    </link>

    <joint name="front_left_wheel_joint" type="revolute">
      <parent>front_left_steering</parent>
      <child>front_left_wheel</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit><lower>-1e16</lower><upper>1e16</upper><effort>1e6</effort></limit>
      </axis>
    </joint>

    <!-- ===== FRONT RIGHT STEERING KNUCKLE ===== -->
    <link name="front_right_steering">
      <pose>1.5494 -0.6061 0.2045 0 0 0</pose>
      <inertial>
        <mass>0.1</mass>
        <inertia>
          <ixx>0.0001</ixx><iyy>0.0001</iyy><izz>0.0001</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
    </link>

    <joint name="front_right_steering_joint" type="revolute">
      <parent>chassis</parent>
      <child>front_right_steering</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-0.6787</lower>
          <upper>0.6787</upper>
          <effort>1e6</effort>
          <velocity>10</velocity>
        </limit>
      </axis>
    </joint>

    <!-- FRONT RIGHT WHEEL -->
    <link name="front_right_wheel">
      <pose>1.5494 -0.6061 0.2045 -1.5708 0 0</pose>
      <inertial>
        <mass>8.5</mass>
        <inertia>
          <ixx>0.1048</ixx><iyy>0.1048</iyy><izz>0.1777</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="visual">
        <pose>-0.6033 -0.2045 -0.6237 1.5708 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://fsae_vehicle/meshes/carTire.stl</uri>
            <scale>2.2188 2.2188 2.2188</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.15 0.15 0.15 1</ambient>
          <diffuse>0.15 0.15 0.15 1</diffuse>
        </material>
      </visual>
      <collision name="collision">
        <geometry>
          <cylinder><radius>0.2045</radius><length>0.15</length></cylinder>
        </geometry>
        <surface>
          <friction>
            <ode><mu>1.0</mu><mu2>0.8</mu2></ode>
          </friction>
        </surface>
      </collision>
    </link>

    <joint name="front_right_wheel_joint" type="revolute">
      <parent>front_right_steering</parent>
      <child>front_right_wheel</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit><lower>-1e16</lower><upper>1e16</upper><effort>1e6</effort></limit>
      </axis>
    </joint>

    <!-- ===== REAR LEFT WHEEL (no steering knuckle) ===== -->
    <link name="rear_left_wheel">
      <pose>0 0.6061 0.2045 -1.5708 0 0</pose>
      <inertial>
        <mass>8.5</mass>
        <inertia>
          <ixx>0.1048</ixx><iyy>0.1048</iyy><izz>0.1777</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="visual">
        <pose>-0.6033 -0.2045 -0.6237 1.5708 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://fsae_vehicle/meshes/carTire.stl</uri>
            <scale>2.2188 2.2188 2.2188</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.15 0.15 0.15 1</ambient>
          <diffuse>0.15 0.15 0.15 1</diffuse>
        </material>
      </visual>
      <collision name="collision">
        <geometry>
          <cylinder><radius>0.2045</radius><length>0.15</length></cylinder>
        </geometry>
        <surface>
          <friction>
            <ode><mu>1.0</mu><mu2>0.8</mu2></ode>
          </friction>
        </surface>
      </collision>
    </link>

    <joint name="rear_left_wheel_joint" type="revolute">
      <parent>chassis</parent>
      <child>rear_left_wheel</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit><lower>-1e16</lower><upper>1e16</upper><effort>1e6</effort></limit>
      </axis>
    </joint>

    <!-- ===== REAR RIGHT WHEEL (no steering knuckle) ===== -->
    <link name="rear_right_wheel">
      <pose>0 -0.6061 0.2045 -1.5708 0 0</pose>
      <inertial>
        <mass>8.5</mass>
        <inertia>
          <ixx>0.1048</ixx><iyy>0.1048</iyy><izz>0.1777</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="visual">
        <pose>-0.6033 -0.2045 -0.6237 1.5708 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://fsae_vehicle/meshes/carTire.stl</uri>
            <scale>2.2188 2.2188 2.2188</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.15 0.15 0.15 1</ambient>
          <diffuse>0.15 0.15 0.15 1</diffuse>
        </material>
      </visual>
      <collision name="collision">
        <geometry>
          <cylinder><radius>0.2045</radius><length>0.15</length></cylinder>
        </geometry>
        <surface>
          <friction>
            <ode><mu>1.0</mu><mu2>0.8</mu2></ode>
          </friction>
        </surface>
      </collision>
    </link>

    <joint name="rear_right_wheel_joint" type="revolute">
      <parent>chassis</parent>
      <child>rear_right_wheel</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit><lower>-1e16</lower><upper>1e16</upper><effort>1e6</effort></limit>
      </axis>
    </joint>

    <!-- ===== STEERING: direct position control (bypasses physics solver) ===== -->
    <plugin
      filename="gz-sim-joint-position-controller-system"
      name="gz::sim::systems::JointPositionController">
      <joint_name>front_left_steering_joint</joint_name>
      <topic>/model/fsae_vehicle/joint/front_left_steering_joint/cmd_pos</topic>
      <use_velocity_commands>true</use_velocity_commands>
      <!-- velocity the controller may command to reach the target; a sim
           tuning knob kept high for near-instant response, distinct from the
           joint's physical rate limit above -->
      <cmd_max>10.0</cmd_max>
      <cmd_min>-10.0</cmd_min>
    </plugin>

    <plugin
      filename="gz-sim-joint-position-controller-system"
      name="gz::sim::systems::JointPositionController">
      <joint_name>front_right_steering_joint</joint_name>
      <topic>/model/fsae_vehicle/joint/front_right_steering_joint/cmd_pos</topic>
      <use_velocity_commands>true</use_velocity_commands>
      <!-- velocity the controller may command to reach the target; a sim
           tuning knob kept high for near-instant response, distinct from the
           joint's physical rate limit above -->
      <cmd_max>10.0</cmd_max>
      <cmd_min>-10.0</cmd_min>
    </plugin>

    <!-- ===== DRIVE: direct velocity control ===== -->
    <plugin
      filename="gz-sim-joint-controller-system"
      name="gz::sim::systems::JointController">
      <joint_name>front_left_wheel_joint</joint_name>
      <topic>/model/fsae_vehicle/joint/front_left_wheel_joint/cmd_vel</topic>
    </plugin>

    <plugin
      filename="gz-sim-joint-controller-system"
      name="gz::sim::systems::JointController">
      <joint_name>front_right_wheel_joint</joint_name>
      <topic>/model/fsae_vehicle/joint/front_right_wheel_joint/cmd_vel</topic>
    </plugin>

    <plugin
      filename="gz-sim-joint-controller-system"
      name="gz::sim::systems::JointController">
      <joint_name>rear_left_wheel_joint</joint_name>
      <topic>/model/fsae_vehicle/joint/rear_left_wheel_joint/cmd_vel</topic>
    </plugin>

    <plugin
      filename="gz-sim-joint-controller-system"
      name="gz::sim::systems::JointController">
      <joint_name>rear_right_wheel_joint</joint_name>
      <topic>/model/fsae_vehicle/joint/rear_right_wheel_joint/cmd_vel</topic>
    </plugin>

    <!-- ===== GROUND-TRUTH ODOMETRY (world-frame pose, not wheel encoders) ===== -->
    <plugin
      filename="gz-sim-odometry-publisher-system"
      name="gz::sim::systems::OdometryPublisher">
      <odom_topic>/model/fsae_vehicle/odometry</odom_topic>
      <!-- Harmonic defaults to /pose; the bridge explicitly consumes /tf. -->
      <tf_topic>/model/fsae_vehicle/tf</tf_topic>
      <odom_frame>map</odom_frame>
      <robot_base_frame>base_link</robot_base_frame>
      <odom_publish_frequency>50</odom_publish_frequency>
    </plugin>

  </model>
</sdf>
