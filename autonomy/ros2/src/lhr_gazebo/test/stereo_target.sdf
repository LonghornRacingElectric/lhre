<?xml version="1.0"?>
<sdf version="1.9">
<world name="stereo_test">
<plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
<plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
<plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
<plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"><render_engine>ogre2</render_engine></plugin>
<plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
<gravity>0 0 0</gravity>
<scene><ambient>1 1 1 1</ambient><background>0.2 0.2 0.2 1</background></scene>
<physics name="default_physics" type="ode"><max_step_size>0.001</max_step_size><real_time_factor>1</real_time_factor></physics>
<light type="directional" name="sun"><pose>0 0 10 0 0 0</pose><diffuse>1 1 1 1</diffuse><direction>-1 0 -1</direction></light>
<include><uri>model://fsae_vehicle</uri><name>fsae_vehicle</name><pose>0 0 0 0 0 0</pose><static>false</static></include>
<model name="target"><static>true</static><pose>6.805 0 0.65 0 0 0</pose><link name="target"><visual name="board"><geometry><box><size>0.01 1 1</size></box></geometry><material><ambient>0 1 0 1</ambient><diffuse>0 1 0 1</diffuse></material></visual></link></model>
</world>
</sdf>
