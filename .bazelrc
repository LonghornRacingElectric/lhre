# Windows-specific settings (no-ops on macOS/Linux)
startup --windows_enable_symlinks
build --enable_runfiles

# Automatically apply build:windows / build:macos / build:linux based on the
# host OS, so nobody has to pass --config flags by hand.
common --enable_platform_specific_config

build --@protobuf//bazel/flags:prefer_prebuilt_protoc=true

# These builds are done remotely by default
# use --config=local or --config=offline to build locally
build --bes_results_url=https://lhre.buildbuddy.io/invocation/
build --bes_backend=grpcs://lhre.buildbuddy.io
build --remote_cache=grpcs://lhre.buildbuddy.io
build --remote_timeout=10m
build --remote_executor=grpcs://lhre.buildbuddy.io
build --remote_cache_compression
build --jobs=50

# Prefer the BuildBuddy Linux x86_64 execution platform for build actions.
# Its container image ships the GCC that @buildbuddy_toolchain//:ubuntu_cc_toolchain
# (registered in MODULE.bazel) expects, so C++ host tools resolve and compile
# remotely regardless of the OS bazel is invoked from.
build --extra_execution_platforms=@buildbuddy_toolchain//:platform_linux_x86_64

build:local --remote_executor=
build:local --remote_cache=
build:local --bes_backend=
build:local --bes_results_url=
build:local --extra_execution_platforms=

# Windows: no remote execution (MSVC can't resolve against the Linux exec
# platform) but keep remote cache + BES for team cache sharing and build
# visibility.
build:windows --remote_executor=
build:windows --extra_execution_platforms=

build:offline --config=local
build:offline --nofetch

try-import %workspace%/.bazelrc.user
