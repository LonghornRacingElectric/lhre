# Windows-specific settings (no-ops on macOS/Linux)
startup --windows_enable_symlinks
build --enable_runfiles

# Automatically apply build:windows / build:macos / build:linux based on the
# host OS, so nobody has to pass --config flags by hand.
common --enable_platform_specific_config

build --@protobuf//bazel/flags:prefer_prebuilt_protoc=true

# Don't auto-generate __init__.py files in py_binary/py_test runfiles (the
# rules_python default is deprecated and warns on every run). All our Python
# is standalone scripts, so nothing depends on the implicit packages.
build --incompatible_default_to_explicit_init_py

# Remote cache + BuildBuddy result streaming: enabled on every platform.
# use --config=local or --config=offline to build fully locally.
build --bes_results_url=https://lhre.buildbuddy.io/invocation/
build --bes_backend=grpcs://lhre.buildbuddy.io
build --remote_cache=grpcs://lhre.buildbuddy.io
build --remote_timeout=10m
build --remote_cache_compression

# Build provenance stamping: the workspace status script emits STABLE_GIT_*
# keys into bazel-out/stable-status.txt; //tools/firmware:build_info turns
# them into a generated header linked into every firmware binary. Same
# ordering gotcha as remote execution below: a plain `build` line would
# silently override build:windows, so the command is only ever SET inside the
# per-OS configs (.sh for Linux/macOS, .bat for Windows).
build:linux --workspace_status_command=tools/workspace_status.sh
build:macos --workspace_status_command=tools/workspace_status.sh
build:windows --workspace_status_command=tools/workspace_status.bat

# Use a fixed PATH in action environments instead of inheriting the client's.
# This keeps remote cache keys stable across machines and gives remote Linux
# actions a sane PATH regardless of the client OS.
build --incompatible_strict_action_env

# Never strip at link time. Bazel's default (--strip=sometimes) adds -Wl,-S
# in fastbuild, which silently discards the DWARF that //toolchains bakes in
# with -g3 — the firmware .elf must keep it for VS Code debugging (see
# tools/debug), and objcopy already strips it from the .bin/.hex images.
build --strip=never

# --- Remote EXECUTION: Linux and macOS clients only --------------------------
# Ordering gotcha (verified on Bazel 9.2.0): the build:<os> config injected by
# --enable_platform_specific_config is expanded BEFORE the plain `build` lines
# in this file, so a plain `build --remote_executor=...` line silently
# overrides `build:windows --remote_executor=`. "Set globally, clear on
# Windows" therefore does NOT work; remote-execution flags must only ever be
# SET here, inside the per-OS configs that should have them.
#
# Windows: remote execution stays off. Bazel cannot reliably drive Linux
# executors from a Windows client — it bakes a Windows-style PATH into remote
# action environments (gcc on the executor dies with "cannot execute 'as'")
# and mis-resolves the absolute Linux include paths gcc reports in .d files
# (long-standing upstream limitations, see bazelbuild/bazel#19587). Windows
# builds run fully locally: the ARM toolchain is hermetic, and the small
# launcher tools need MSVC Build Tools with the Windows SDK installed. Remote
# cache + BES streaming stay enabled above, so Windows machines still share
# cache artifacts with each other. Windows users who want full remote
# execution should run bazel from inside WSL2 (clone the repo in WSL), which
# makes them a Linux client and picks up build:linux automatically.
#
# The @buildbuddy_toolchain platform's container image ships the GCC that
# @buildbuddy_toolchain//:ubuntu_cc_toolchain (registered in MODULE.bazel)
# expects, so C++ host tools resolve and compile remotely.
# --host_platform=//platforms:host_no_remote_exec is the host platform with
# "no-remote-exec" stamped on: actions whose exec platform resolves to the
# host (rules_rust compiling host-targeted crates and their bootstrap tools)
# must run on this machine — the executors are Linux and can't run host
# binaries. C++ is unaffected (hermetic LLVM resolves to the Linux exec
# platform and cross-compiles). Only set where remote execution is on.
build:linux --remote_executor=grpcs://lhre.buildbuddy.io
build:linux --extra_execution_platforms=@buildbuddy_toolchain//:platform_linux_x86_64
build:linux --host_platform=//platforms:host_no_remote_exec
build:linux --jobs=50
test:linux --platforms=@buildbuddy_toolchain//:platform_linux_x86_64
build:macos --remote_executor=grpcs://lhre.buildbuddy.io
build:macos --extra_execution_platforms=@buildbuddy_toolchain//:platform_linux_x86_64
build:macos --host_platform=//platforms:host_no_remote_exec
build:macos --jobs=50
test:macos --platforms=@buildbuddy_toolchain//:platform_linux_x86_64

# Explicit --config flags expand after the plain rc lines above, so these
# overrides really do take effect (unlike the platform-specific configs).
# Host-targeted tests (unit tests, sims) execute on the Linux remote
# executors by default on Linux and macOS, so target Linux there — the binaries
# must be runnable where the test action executes. On Windows, tests execute
# locally, so they target the host platform by default. The hermetic LLVM
# toolchain (MODULE.bazel) compiles them either way; --config=local reverts
# to this machine's platform and runs tests here.
test:local --platforms=
test:windows --platforms=

build:local --remote_executor=
build:local --remote_cache=
build:local --bes_backend=
build:local --bes_results_url=
build:local --extra_execution_platforms=
build:local --jobs=auto

build:offline --config=local
build:offline --nofetch

try-import %workspace%/.bazelrc.user
